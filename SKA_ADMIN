-- ANTI-VC BAN  (open-source legacy approach)
-- ============================================================
-- Monitors if the local player is being removed for a VC ban
-- and automatically teleports back to the same place.
local antiVCConnection = nil

local function enableAntiVCBan()
    if antiVCConnection then return end
    antiVCConnection = localPlayer.OnTeleport:Connect(function(state, placeId, spawnName)
        -- If we're being teleported OUT unexpectedly, rejoin
        if state == Enum.TeleportState.RequestedFromServer then
            task.wait(1)
            if State.AntiVCBan then
                TeleportService:Teleport(game.PlaceId, localPlayer)
            end
        end
    end)
    -- Also watch for kick events via PlayerRemoving as a guard
    log("Anti-VC Ban enabled")
    notify("Anti-VC Ban","Active — rejoins on VC kick",3)
end

local function disableAntiVCBan()
    if antiVCConnection then
        antiVCConnection:Disconnect()
        antiVCConnection = nil
    end
    notify("Anti-VC Ban","Disabled",2)
end

