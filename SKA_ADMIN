local function httpGetRaw(url)
    -- Prefer game:HttpGet, fall back to executor request APIs
    local ok, raw = pcall(function()
        return game:HttpGet(url, true)
    end)
    if ok and raw and raw ~= "" and not tostring(raw):find("<!DOCTYPE") and not tostring(raw):find("<html") then
        return raw
    end
    if http_request then
        local ok2, res = pcall(function()
            return http_request({ Url = url, Method = "GET" })
        end)
        if ok2 and res then
            local body = res.Body or res.body
            if body and body ~= "" then return body end
        end
    end
    return nil
end

local function fetchGitHub()
    pcall(function()
        local raw = httpGetRaw(CONFIG.GitHubURL)
        if not raw or raw == "" then
            log("fetchGitHub FAILED — empty response / HttpGet blocked")
            return
        end
        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok or type(data) ~= "table" then
            log("fetchGitHub FAILED — JSON decode error")
            return
        end

        ServerData.Users    = data.users    or {}
        ServerData.Banned   = data.banned   or {}
        if data.globalSettings then
            ServerData.GlobalSettings = data.globalSettings
        end

        -- Ban check — ALWAYS re-evaluate (fixes sticky ban after unban)
        local banEntry = findUserEntry(ServerData.Banned, localPlayer.Name)
        if banEntry then
            LocalUser.IsBanned  = true
            LocalUser.BanReason = banEntry.reason or "No reason given"
            LocalUser.BannedBy  = banEntry.bannedBy or "an admin"
            -- Kick immediately with JSON reason
            local msg = string.format(
                "Banned from SKA by %s\nReason: %s",
                tostring(LocalUser.BannedBy),
                tostring(LocalUser.BanReason)
            )
            task.defer(function()
                pcall(function() localPlayer:Kick(msg) end)
            end)
            log("BANNED — kicking: "..msg)
            return
        else
            -- Explicitly clear ban if they were previously banned this session
            LocalUser.IsBanned  = false
            LocalUser.BanReason = nil
            LocalUser.BannedBy  = nil
        end

        -- Load own data (case-insensitive username match)
        local me = findUserEntry(ServerData.Users, localPlayer.Name)
        if me then
            LocalUser.Rank    = tonumber(me.rank) or 0
            LocalUser.Tag     = me.tag  or (RANK_INFO[LocalUser.Rank] and RANK_INFO[LocalUser.Rank].Tag) or "SKA USER (free)"
            LocalUser.CanEditNametag = me.canEditNametag == true or (LocalUser.Rank >= 1)
            if me.tagColor        then LocalUser.TagColor         = strToColor(me.tagColor)        end
            if me.glowColor       then LocalUser.GlowColor        = strToColor(me.glowColor)       end
            if me.outlineColor    then LocalUser.OutlineColor     = strToColor(me.outlineColor)    end
            if me.backgroundColor then LocalUser.BackgroundColor  = strToColor(me.backgroundColor) end
            if me.font            then LocalUser.Font             = me.font                        end
            if me.logo            then LocalUser.Logo             = me.logo                        end
            if me.animation       then LocalUser.Animation        = me.animation                   end
        else
            -- Not in JSON → free user
            LocalUser.Rank           = 0
            LocalUser.Tag            = RANK_INFO[0].Tag
            LocalUser.CanEditNametag = false
            LocalUser.TagColor       = RANK_INFO[0].Color
        end

        -- Clamp rank to known range
        if not RANK_INFO[LocalUser.Rank] then
            LocalUser.Rank = 0
        end

        -- Set allowed commands
        local rankKey = LocalUser.Rank == 3 and "ownerCommands"
                     or LocalUser.Rank == 2 and "adminCommands"
                     or LocalUser.Rank == 1 and "paidUserCommands"
                     or "freeUserCommands"
        LocalUser.AllowedCommands = ServerData.GlobalSettings[rankKey] or {}

        log("Loaded. Name="..localPlayer.Name.." Rank="..LocalUser.Rank.." Tag="..tostring(LocalUser.Tag))
    end)
end

