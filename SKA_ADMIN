	portalBtn.MouseEnter:Connect(function()
		TweenService:Create(portalGui, TweenInfo.new(0.15), {Size = UDim2.new(0, 48, 0, 48)}):Play()
	end)
	portalBtn.MouseLeave:Connect(function()
		TweenService:Create(portalGui, TweenInfo.new(0.15), {Size = UDim2.new(0, 42, 0, 42)}):Play()
	end)

	-- Teleport on portal click
	portalBtn.MouseButton1Click:Connect(function()
		if not player.Character then return end
		local myHRP = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
		local tgHRP = player.Character:FindFirstChild("HumanoidRootPart")
		if myHRP and tgHRP then
			myHRP.CFrame = tgHRP.CFrame * CFrame.new(0, 0, 4)
			notify("Teleport", "Teleported to " .. player.Name, 2)
		end
	end)

	return {
		Gui        = bgui,
		Container  = container,
		TagLabel   = tagLabel,
		NameLabel  = nameLabel,
		Glow       = glow,
		Stroke     = stroke,
		LogoFrame  = logoFrame,
		LogoImage  = logoImg,
		LogoText   = logoLabel,
		BadgeText  = badgeText,
		PortalGui  = portalGui,
		PortalBtn  = portalBtn,
		TagGrad    = tagGrad,
		BgGrad     = bgGrad,
		EffectLayer= effectLayer,
		BgImage    = bgImage,
		Player     = player,
		AnimT      = 0,
		BaseTagText= tagText,
	}
end

-- ============================================================
-- NAMETAG ANIMATION / EFFECTS ENGINE
-- ============================================================
local function scrambleText(src, t)
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&"
	local out = {}
	for i = 1, #src do
		local ch = src:sub(i,i)
		if ch == " " then
			out[i] = " "
		elseif math.noise(i * 0.3, t * 2) > 0.15 then
			local idx = (math.floor(t * 20 + i * 7) % #chars) + 1
			out[i] = chars:sub(idx, idx)
		else
			out[i] = ch
		end
	end
	return table.concat(out)
end

local function applyNametagAnim(tag, anim, bgAnim, effect1, effect2, e1col, e2col, tagColor, outlineColor)
	if not tag or not tag.TagLabel or not tag.Container then return end
	tag.AnimT = (tag.AnimT or 0) + 0.016
	local t = tag.AnimT
	local base = tag.BaseTagText or tag.TagLabel.Text
	anim = anim or "None"
	bgAnim = bgAnim or "None"
	effect1 = effect1 or "None"
	effect2 = effect2 or "None"
	tagColor = tagColor or Color3.new(1,1,1)
	outlineColor = outlineColor or tagColor
	tag._animLock = false

	if bgAnim ~= "Ripple" then
		tag.Container.Size = UDim2.new(1, 0, 1, 0)
		tag.Container.Position = UDim2.new(0, 0, 0, 0)
	end
	if anim ~= "Bounce" then tag.TagLabel.Position = UDim2.new(0, 34, 0, 2) end
	if anim ~= "Wave" then tag.TagLabel.Rotation = 0 end
	if anim ~= "Pulse" then tag.TagLabel.TextSize = 11 end

	if anim == "None" then
		if tag.TagGrad then tag.TagGrad.Enabled = false end
		tag.TagLabel.TextTransparency = 0
	elseif anim == "Pulse" then
		tag.TagLabel.TextSize = 11 + math.sin(t * 3) * 1.2
	elseif anim == "Bounce" then
		tag.TagLabel.Position = UDim2.new(0, 34, 0, 2 + math.sin(t * 5) * 1.5)
	elseif anim == "Wave" then
		tag.TagLabel.Rotation = math.sin(t * 2.5) * 3
	elseif anim == "Shine" or anim == "Halo" or anim == "Neon" then
		if tag.TagGrad then
			tag.TagGrad.Enabled = true
			tag.TagGrad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, tagColor),
				ColorSequenceKeypoint.new(0.45, Color3.new(1,1,1)),
				ColorSequenceKeypoint.new(1, tagColor),
			})
			tag.TagGrad.Offset = Vector2.new(math.sin(t * 1.4) * 0.55, 0)
		end
	elseif anim == "Rainbow" or anim == "Chroma" then
		if tag.TagGrad then
			tag.TagGrad.Enabled = true
			local h = (t * 0.12) % 1
			tag.TagGrad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromHSV(h, 0.85, 1)),
				ColorSequenceKeypoint.new(0.5, Color3.fromHSV((h+0.33)%1, 0.85, 1)),
				ColorSequenceKeypoint.new(1, Color3.fromHSV((h+0.66)%1, 0.85, 1)),
			})
			tag.TagGrad.Offset = Vector2.new((t * 0.2) % 1 - 0.5, 0)
		end
	elseif anim == "Fade" then
		tag.TagLabel.TextTransparency = 0.15 + 0.25 * (math.sin(t * 1.8) * 0.5 + 0.5)
	elseif anim == "Typing" or anim == "Fizz" then
		local len = math.max(1, math.floor((t % (#base + 1.5))))
		if len > #base then len = #base end
		tag.TagLabel.Text = base:sub(1, len)
		tag._animLock = true
	elseif anim == "Scramble" or anim == "Matrix" or anim == "Warp" then
		if not tag._scrambleNext or t >= tag._scrambleNext then
			tag.TagLabel.Text = scrambleText(base, t)
			tag._scrambleNext = t + 0.12
		end
		tag._animLock = true
	elseif anim == "Electric" then
		local flash = (math.sin(t * 18) > 0.92)
		tag.TagLabel.TextColor3 = flash and Color3.new(1,1,1) or tagColor
	end

	if tag.BgGrad then tag.BgGrad.Enabled = false end

	if bgAnim == "None" then
		tag.Container.BackgroundTransparency = 0.12
		tag.Stroke.Thickness = 1.5
	elseif bgAnim == "Pulse" or bgAnim == "Breath" then
		tag.Container.BackgroundTransparency = 0.05 + 0.18 * (math.sin(t * 2) * 0.5 + 0.5)
	elseif bgAnim == "Soft Glow" then
		tag.Glow.ImageTransparency = 0.55 + 0.25 * math.sin(t * 2.2)
		tag.Glow.ImageColor3 = tagColor
	elseif bgAnim == "Rainbow Border" then
		tag.Stroke.Color = Color3.fromHSV((t * 0.15) % 1, 0.85, 1)
		tag.Stroke.Thickness = 2
	elseif bgAnim == "Gradient Flow" then
		-- Moving gradient across the whole tag background
		if tag.BgGrad then
			tag.BgGrad.Enabled = true
			local h = (t * 0.12) % 1
			tag.BgGrad.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromHSV(h, 0.55, 0.35)),
				ColorSequenceKeypoint.new(0.5, Color3.fromHSV((h+0.25)%1, 0.7, 0.55)),
				ColorSequenceKeypoint.new(1, Color3.fromHSV((h+0.5)%1, 0.55, 0.35)),
			})
			tag.BgGrad.Offset = Vector2.new((t * 0.25) % 1 - 0.5, 0)
		end
		tag.Stroke.Color = Color3.fromHSV((t * 0.1) % 1, 0.5, 1)
	elseif bgAnim == "Scanline" then
		if tag.BgImage and tag.BgImage.Visible then
			tag.BgImage.ImageTransparency = 0.3 + 0.35 * math.sin(t * 4)
		else
			tag.Container.BackgroundTransparency = 0.1 + 0.2 * (math.sin(t * 5) * 0.5 + 0.5)
		end
	elseif bgAnim == "Ripple" then
		local s = 1 + 0.03 * math.sin(t * 3)
		tag.Container.Size = UDim2.new(s, 0, s, 0)
		tag.Container.Position = UDim2.new(0.5 - s/2, 0, 0.5 - s/2, 0)
	elseif bgAnim == "Flicker" or bgAnim == "Glitch Border" then
		tag.Stroke.Thickness = (math.sin(t * 9) > 0.85) and 2.2 or 1.5
	end

	local function applyEffect(name, col)
		if not name or name == "None" then return end
		col = col or tagColor
		if name == "Glow Pulse" then
			tag.Glow.ImageColor3 = col
			tag.Glow.ImageTransparency = 0.72 + 0.18 * math.sin(t * 3)
		elseif name == "Flame" then
			local mix = 0.5 + 0.5 * math.sin(t * 5)
			tag.Glow.ImageColor3 = col:Lerp(Color3.fromRGB(255, 110, 30), mix)
			tag.Glow.ImageTransparency = 0.62
		elseif name == "Aura Ring" or name == "Smoke" then
			tag.Glow.ImageColor3 = col
			tag.Glow.ImageTransparency = 0.8 + 0.1 * math.sin(t * 1.6)
		elseif name == "Particles" or name == "Sparkle" or name == "Stars" then
			tag.Glow.ImageColor3 = col
			tag.Glow.ImageTransparency = 0.85 + 0.08 * math.sin(t * 6)
		elseif name == "Lightning" then
			tag.Stroke.Thickness = (math.sin(t * 14) > 0.94) and 2.4 or 1.5
		elseif name == "Glitch" then
			tag.Container.Position = (math.sin(t * 11) > 0.97) and UDim2.new(0, 1, 0, 0) or UDim2.new(0, 0, 0, 0)
		end
	end
	applyEffect(effect1, e1col)
	applyEffect(effect2, e2col)

	if bgAnim ~= "Rainbow Border" and bgAnim ~= "Gradient Flow" then
		if effect1 ~= "Lightning" and effect2 ~= "Lightning" then
			tag.Stroke.Color = outlineColor
		end
	end
end

-- Update loop — uses RenderStepped exactly like the working version
local function destroyNametag(player)
	local tag = Nametags[player]
	if not tag then return end
	pcall(function() if tag.Gui then tag.Gui:Destroy() end end)
	pcall(function() if tag.PortalGui then tag.PortalGui:Destroy() end end)
	Nametags[player] = nil
end

local function isSKAPlayer(player)
	if player == localPlayer then return true end
	local bridge = ActiveSKAUsers[player.Name] or findUserEntry(ActiveSKAUsers, player.Name)
	if bridge then
		if not bridge.jobId or bridge.jobId == game.JobId then
			return true
		end
	end
	-- In this Roblox server + listed in GitHub JSON
	if findUserEntry(ServerData.Users, player.Name) then
		return true
	end
	return false
end

local function updateNametags()
	local myChar = localPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	for _, player in ipairs(Players:GetPlayers()) do
		local shouldShow = isSKAPlayer(player)

		if shouldShow then
			local char = player.Character
			local head = char and char:FindFirstChild("Head")

			if head then
				local tag = Nametags[player]
				-- Rebuild if missing, Gui gone, or adornee stuck on a destroyed head
				local needsRebuild = false
				if not tag then
					needsRebuild = true
				elseif not tag.Gui or not tag.Gui.Parent then
					needsRebuild = true
				elseif tag.Gui.Adornee ~= head then
					local ok = pcall(function()
						tag.Gui.Adornee = head
						if tag.PortalGui then tag.PortalGui.Adornee = head end
					end)
					if not ok then needsRebuild = true end
				end

				if needsRebuild then
					destroyNametag(player)
					local ok, result = pcall(function() return createNametag(player) end)
					if ok and result then
						Nametags[player] = result
						tag = result
					else
						tag = nil
					end
				end

				if tag and tag.Gui then
					pcall(function()
						tag.Gui.Adornee = head
						tag.Gui.Enabled = true
					end)
					-- Live-update tags from shared data
					if player == localPlayer then
						tag.TagLabel.TextColor3        = LocalUser.TagColor
						tag.Stroke.Color               = LocalUser.OutlineColor
						tag.Glow.ImageColor3           = LocalUser.GlowColor
						tag.Container.BackgroundColor3 = LocalUser.BackgroundColor
						tag.TagLabel.Font              = Enum.Font[LocalUser.Font] or Enum.Font.GothamBold
						tag.BaseTagText                = LocalUser.Tag
						if not tag._animLock then
							tag.TagLabel.Text          = LocalUser.Tag
						end
						tag.LogoFrame.BackgroundColor3 = LocalUser.TagColor
						local uname = (LocalUser.CustomUsername ~= "" and LocalUser.CustomUsername) or localPlayer.Name
						tag.NameLabel.Text             = "@" .. uname
						tag.NameLabel.TextColor3       = LocalUser.UsernameColor
						tag.NameLabel.Font             = Enum.Font[LocalUser.UsernameFont] or Enum.Font.Gotham
						local myLogo = normalizeAsset(LocalUser.Logo)
						if tag.LogoImage and myLogo then
							tag.LogoImage.Image = myLogo
							tag.LogoImage.Visible = true
							if tag.LogoText then tag.LogoText.Visible = false end
						elseif tag.LogoImage then
							tag.LogoImage.Visible = false
							if tag.LogoText then tag.LogoText.Visible = true end
						end
						if tag.BgImage then
							local myBg = normalizeAsset(LocalUser.BgImage)
							if myBg then
								tag.BgImage.Image = myBg
								tag.BgImage.Visible = true
							else
								tag.BgImage.Visible = false
							end
						end
						if tag.BadgeText then
							tag.BadgeText.Text = tostring(LocalUser.Rank)
						end
						applyNametagAnim(tag, LocalUser.Animation, LocalUser.BgAnimation, LocalUser.Effect1, LocalUser.Effect2, LocalUser.Effect1Color, LocalUser.Effect2Color, LocalUser.TagColor, LocalUser.OutlineColor)
					else
						local userData = getMergedUserData(player.Name)
						local rank     = getUserRank(player.Name)
						local tagText  = userData.tag or getUserTag(player.Name)
						local tagColor = (userData.tagColor and strToColor(userData.tagColor)) or (RANK_INFO[rank] and RANK_INFO[rank].Color) or Color3.fromRGB(160,160,160)
						local glowColor = (userData.glowColor and strToColor(userData.glowColor)) or tagColor
						local bgColor  = (userData.backgroundColor and strToColor(userData.backgroundColor)) or Color3.fromRGB(20, 20, 25)
						local outlineColor = (userData.outlineColor and strToColor(userData.outlineColor)) or tagColor
						local font     = userData.font or "GothamBold"

						tag.BaseTagText = tagText
						if not tag._animLock then
							tag.TagLabel.Text = tagText
						end
						tag.TagLabel.TextColor3        = tagColor
						tag.TagLabel.Font              = Enum.Font[font] or Enum.Font.GothamBold
						tag.Glow.ImageColor3           = glowColor
						tag.Container.BackgroundColor3 = bgColor
						tag.LogoFrame.BackgroundColor3 = tagColor

						if userData.customUsername and userData.customUsername ~= "" then
							tag.NameLabel.Text = "@" .. userData.customUsername
						else
							tag.NameLabel.Text = "@" .. player.Name
						end
						if userData.usernameColor then
							tag.NameLabel.TextColor3 = strToColor(userData.usernameColor)
						end
						if userData.usernameFont then
							tag.NameLabel.Font = Enum.Font[userData.usernameFont] or Enum.Font.Gotham
						end

						local logoId = normalizeAsset(userData.logo)
						if tag.LogoImage and logoId then
							tag.LogoImage.Image = logoId
							tag.LogoImage.Visible = true
							if tag.LogoText then tag.LogoText.Visible = false end
						elseif tag.LogoImage then
							tag.LogoImage.Visible = false
							if tag.LogoText then tag.LogoText.Visible = true end
						end

						local bgId = normalizeAsset(userData.bgImage)
						if tag.BgImage then
							if bgId then
								tag.BgImage.Image = bgId
								tag.BgImage.Visible = true
							else
								tag.BgImage.Visible = false
							end
						end

						if tag.BadgeText then
							tag.BadgeText.Text = tostring(rank)
						end

						local anim = userData.animation or "None"
						local bga  = userData.bgAnimation or "None"
						local e1   = userData.effect1 or "None"
						local e2   = userData.effect2 or "None"
						local e1c  = userData.effect1Color and strToColor(userData.effect1Color) or tagColor
						local e2c  = userData.effect2Color and strToColor(userData.effect2Color) or tagColor
						applyNametagAnim(tag, anim, bga, e1, e2, e1c, e2c, tagColor, outlineColor)
					end

					-- Distance-based visibility
					if myRoot and player ~= localPlayer then
						local tRoot = player.Character:FindFirstChild("HumanoidRootPart")
						if tRoot then
							local dist = (myRoot.Position - tRoot.Position).Magnitude
							if dist < CONFIG.NametagDistance then
								tag.Container.Visible = true
								if tag.PortalGui then tag.PortalGui.Enabled = false end
							elseif dist < CONFIG.PortalDistance then
								tag.Container.Visible = false
								if tag.PortalGui then
									tag.PortalGui.Enabled = true
									tag.PortalGui.Adornee = player.Character.Head
								end
							else
								tag.Container.Visible = false
								if tag.PortalGui then tag.PortalGui.Enabled = false end
							end
						end
					else
						-- Self: always show
						tag.Container.Visible = true
						if tag.PortalGui then tag.PortalGui.Enabled = false end
					end
				end
			else
				-- Dead / no character yet — clear stale tag so respawn rebuilds cleanly
				if Nametags[player] then
					destroyNametag(player)
				end
			end
		else
			-- Not SKA / not same server
			if Nametags[player] then
				destroyNametag(player)
			end
		end
	end
end

