-- Update loop — uses RenderStepped exactly like the working version
local function updateNametags()
	local myChar = localPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")

	for _, player in ipairs(Players:GetPlayers()) do
		local bridgeData = ActiveSKAUsers[player.Name]

		-- Show nametag only if:
		--   (a) it's the local player themselves, OR
		--   (b) this player is in ActiveSKAUsers AND shares the same JobId (same server)
		local inSameServer = bridgeData and (bridgeData.jobId == game.JobId)
		local shouldShow   = (player == localPlayer) or inSameServer

		if shouldShow then
			if player.Character and player.Character:FindFirstChild("Head") then
				-- Create nametag if it doesn't exist yet
				if not Nametags[player] then
					Nametags[player] = createNametag(player)
				end

				local tag = Nametags[player]
				if tag and tag.Gui then
					-- Always keep adornee pointed at current head (handles respawns)
					tag.Gui.Adornee = player.Character.Head

					-- Live-update tags from shared data
					if player == localPlayer then
						-- Own tag always comes from LocalUser (editor + JSON)
						tag.TagLabel.TextColor3        = LocalUser.TagColor
						tag.Stroke.Color               = LocalUser.OutlineColor
						tag.Glow.ImageColor3           = LocalUser.GlowColor
						tag.Container.BackgroundColor3 = LocalUser.BackgroundColor
						tag.TagLabel.Font              = Enum.Font[LocalUser.Font] or Enum.Font.GothamBold
						tag.TagLabel.Text              = LocalUser.Tag
						tag.LogoFrame.BackgroundColor3 = LocalUser.TagColor
						if tag.BadgeText then
							tag.BadgeText.Text = tostring(LocalUser.Rank)
						end
					else
						-- Other players: prefer live bridge (same server), then GitHub JSON
						local userData = ActiveSKAUsers[player.Name] or ServerData.Users[player.Name] or {}
						local rank     = getUserRank(player.Name)
						local tagText  = userData.tag or getUserTag(player.Name)
						local tagColor = (userData.tagColor and strToColor(userData.tagColor)) or RANK_INFO[rank].Color
						local glowColor = (userData.glowColor and strToColor(userData.glowColor)) or tagColor
						local bgColor  = (userData.backgroundColor and strToColor(userData.backgroundColor)) or Color3.fromRGB(20, 20, 25)
						local outlineColor = (userData.outlineColor and strToColor(userData.outlineColor)) or tagColor
						local font     = userData.font or "GothamBold"

						tag.TagLabel.Text              = tagText
						tag.TagLabel.TextColor3        = tagColor
						tag.TagLabel.Font              = Enum.Font[font] or Enum.Font.GothamBold
						tag.Stroke.Color               = outlineColor
						tag.Glow.ImageColor3           = glowColor
						tag.Container.BackgroundColor3 = bgColor
						tag.LogoFrame.BackgroundColor3 = tagColor
						if tag.BadgeText then
							tag.BadgeText.Text = tostring(rank)
						end
					end

					-- Distance-based visibility
					if myRoot and player ~= localPlayer then
						local tRoot = player.Character:FindFirstChild("HumanoidRootPart")
						if tRoot then
							local dist = (myRoot.Position - tRoot.Position).Magnitude
							if dist < CONFIG.NametagDistance then
								tag.Container.Visible = true
								if tag.PortalGui then tag.PortalGui.Enabled = false end
							elseif dist < CONFIG.PortalDistance then
								tag.Container.Visible = false
								if tag.PortalGui then
									tag.PortalGui.Enabled = true
									tag.PortalGui.Adornee = player.Character.Head
								end
							else
								tag.Container.Visible = false
								if tag.PortalGui then tag.PortalGui.Enabled = false end
							end
						end
					else
						-- Self: always show
						tag.Container.Visible = true
						if tag.PortalGui then tag.PortalGui.Enabled = false end
					end
				end
			end
		else
			-- Not in same server or not in bridge — clean up any existing nametag
			if Nametags[player] then
				pcall(function() Nametags[player].Gui:Destroy()      end)
				pcall(function() Nametags[player].PortalGui:Destroy() end)
				Nametags[player] = nil
			end
		end
	end
end

