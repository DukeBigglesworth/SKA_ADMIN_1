-- COLOR HELPERS
-- ============================================================
local function rgbToHex(c)
    return string.format("#%02X%02X%02X",
        math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
end

local function hexToRGB(h)
    if h:sub(1,1)=="#" then h=h:sub(2) end
    if #h~=6 then return Color3.new(1,1,1) end
    return Color3.fromRGB(
        tonumber(h:sub(1,2),16) or 255,
        tonumber(h:sub(3,4),16) or 255,
        tonumber(h:sub(5,6),16) or 255)
end

local function strToColor(s)
    if not s then return Color3.fromRGB(220,40,60) end
    local r,g,b = tostring(s):match("(%d+),%s*(%d+),%s*(%d+)")
    if r then return Color3.fromRGB(tonumber(r),tonumber(g),tonumber(b)) end
    return Color3.fromRGB(220,40,60)
end

local function colorToStr(c)
    return string.format("%d, %d, %d",
        math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255))
end

-- Case-insensitive lookup helper (Roblox usernames can differ in casing)
local function findUserEntry(tbl, name)
    if not tbl or not name then return nil end
    if tbl[name] then return tbl[name] end
    local lower = string.lower(name)
    for k, v in pairs(tbl) do
        if type(k) == "string" and string.lower(k) == lower then
            return v
        end
    end
    return nil
end

-- Resolve a player by username OR display name (exact, then partial)
local function findPlayerFlexible(query)
    if not query or query == "" then return nil end
    query = tostring(query):match("^%s*(.-)%s*$") or ""
    if query == "" then return nil end

    local exact = Players:FindFirstChild(query)
    if exact then return exact end

    local ql = string.lower(query)
    local partial = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        local n = string.lower(plr.Name)
        local d = string.lower(plr.DisplayName or "")
        if n == ql or d == ql then
            return plr
        end
        if n:find(ql, 1, true) or d:find(ql, 1, true) then
            table.insert(partial, plr)
        end
    end
    if #partial == 1 then return partial[1] end
    if #partial > 1 then
        for _, plr in ipairs(partial) do
            if string.lower(plr.DisplayName or ""):sub(1, #ql) == ql
            or string.lower(plr.Name):sub(1, #ql) == ql then
                return plr
            end
        end
        return partial[1]
    end
    return nil
end

