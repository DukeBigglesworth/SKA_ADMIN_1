local function hasPermission(cmd)
    if LocalUser.IsBanned then return false end
    if LocalUser.Rank == 3 then return true end
    local allowed = LocalUser.AllowedCommands or {}
    if table.find(allowed,"all") then return true end
    return table.find(allowed, cmd) ~= nil
end

local function canTarget(targetName)
    if LocalUser.IsBanned then return false end
    if LocalUser.Rank == 3 then return true end
    local entry = findUserEntry(ServerData.Users, targetName)
    local targetRank = (entry and tonumber(entry.rank)) or 0
    if LocalUser.Rank == 2 and targetRank < 2 then return true end
    if LocalUser.Rank == 1 and targetRank < 1 then return true end
    return false
end

local function getUserRank(name)
    -- Prefer live bridge data (same server), then GitHub JSON
    local bridge = ActiveSKAUsers[name] or findUserEntry(ActiveSKAUsers, name)
    if bridge and bridge.rank ~= nil then
        return tonumber(bridge.rank) or 0
    end
    local d = findUserEntry(ServerData.Users, name)
    return (d and tonumber(d.rank)) or 0
end

local function getUserTag(name)
    -- Prefer live bridge custom tag, then GitHub, then rank default
    local bridge = ActiveSKAUsers[name] or findUserEntry(ActiveSKAUsers, name)
    if bridge and bridge.tag and bridge.tag ~= "" then
        return bridge.tag
    end
    local d = findUserEntry(ServerData.Users, name)
    if d and d.tag then return d.tag end
    local r = getUserRank(name)
    return (RANK_INFO[r] and RANK_INFO[r].Tag) or "SKA USER (free)"
end

