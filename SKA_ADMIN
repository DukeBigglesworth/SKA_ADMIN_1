-- MINI BUTTON + SLOW CIRCLE ↔ SQUARE MORPH
-- ============================================================
local function createMiniButton()
    UI.MiniButton = Instance.new("TextButton",UI.ScreenGui)
    UI.MiniButton.Name             = "SKA_Mini"
    UI.MiniButton.Size             = UDim2.new(0,64,0,64)
    UI.MiniButton.Position         = UDim2.new(1, -80, 1, -80)
    UI.MiniButton.BackgroundColor3 = Theme.Background
    UI.MiniButton.Text             = ""
    UI.MiniButton.AutoButtonColor  = false
    UI.MiniButton.Visible          = false
    UI.MiniButton.ClipsDescendants = true
    local miniCorner = Instance.new("UICorner",UI.MiniButton)
    miniCorner.CornerRadius = UDim.new(1,0)

    UI.MiniStroke = Instance.new("UIStroke",UI.MiniButton)
    UI.MiniStroke.Color = Theme.Accent  UI.MiniStroke.Thickness = 2

    local miniLbl = Instance.new("TextLabel", UI.MiniButton)
    miniLbl.Size = UDim2.new(1,0,1,0)
    miniLbl.BackgroundTransparency = 1
    miniLbl.Text = "SKA"
    miniLbl.TextColor3 = Theme.Accent
    miniLbl.Font = Enum.Font.GothamBold
    miniLbl.TextSize = 16
    miniLbl.TextStrokeTransparency = 0.7
    miniLbl.TextStrokeColor3 = Color3.new(0,0,0)
    UI.MiniLabel = miniLbl

    UI.MiniImage = Instance.new("ImageLabel",UI.MiniButton)
    UI.MiniImage.Size = UDim2.new(1,0,1,0)
    UI.MiniImage.BackgroundTransparency = 1
    UI.MiniImage.Image = Theme.MiniImage ~= "" and Theme.MiniImage or ""
    UI.MiniImage.Visible = Theme.MiniImage ~= ""
    Instance.new("UICorner",UI.MiniImage).CornerRadius = UDim.new(1,0)

    local MORPH_INFO = TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
    local MINI_SIZE = UDim2.new(0, 64, 0, 64)

    local function isMobileUI()
        return UserInputService.TouchEnabled and not UserInputService.MouseEnabled
    end

    local function fullMainSize()
        if isMobileUI() then
            return UDim2.new(0.95, 0, 0.80, 0)
        end
        return UDim2.new(0, 320, 0, 480)
    end

    local function setPanelVisible(vis)
        if UI.TabBar then UI.TabBar.Visible = vis end
        if UI.ContentArea then UI.ContentArea.Visible = vis end
        if UI.StatusBar then UI.StatusBar.Visible = vis end
        if UI.CmdBar then UI.CmdBar.Visible = vis end
        if UI.MinBtn then UI.MinBtn.Visible = vis end
        if UI.CloseBtn then UI.CloseBtn.Visible = vis end
        if UI.RankLabel then UI.RankLabel.Visible = vis end
    end

    -- Pixel top-left → offset Position (ScreenGui has IgnoreGuiInset)
    local function dockFromAbs(abs)
        return UDim2.new(0, math.floor(abs.X + 0.5), 0, math.floor(abs.Y + 0.5))
    end

    -- Square → circle: shrink size only (top-left stays put) then hand off to mini
    UI.shrinkToMini = function()
        if State._morphing or not UI.MainFrame or not UI.MiniButton then return end
        if not UI.MainFrame.Visible then return end
        State._morphing = true

        local mf = UI.MainFrame
        local mini = UI.MiniButton
        local corner = mf:FindFirstChildOfClass("UICorner")

        setPanelVisible(false)

        -- Only animate SIZE + corner — do NOT move Position (prevents drift)
        local twSize = TweenService:Create(mf, MORPH_INFO, { Size = MINI_SIZE })
        local twCorner = corner and TweenService:Create(corner, MORPH_INFO, {
            CornerRadius = UDim.new(1, 0),
        })
        twSize:Play()
        if twCorner then twCorner:Play() end
        twSize.Completed:Wait()

        -- One frame so AbsolutePosition is accurate after size change
        task.wait()
        local dock = dockFromAbs(mf.AbsolutePosition)
        State._dockPos = dock

        mini.Position = dock
        mini.Size = MINI_SIZE
        mini.Visible = true
        mf.Visible = false

        -- Keep main docked at same pixel for next expand (still hidden)
        mf.Position = dock
        mf.Size = fullMainSize()
        if corner then corner.CornerRadius = UDim.new(0, 14) end
        setPanelVisible(true)

        State.IsMinimized = true
        State._morphing = false
    end

    -- Circle → square: expand from mini's exact pixel position (no upward jump)
    UI.expandFromMini = function()
        if State._morphing or not UI.MainFrame or not UI.MiniButton then return end
        if UI.MainFrame.Visible then return end
        State._morphing = true

        local mf = UI.MainFrame
        local mini = UI.MiniButton
        local corner = mf:FindFirstChildOfClass("UICorner")
        local targetSize = fullMainSize()

        -- Prefer live mini position (user may have dragged it)
        task.wait()
        local dock = dockFromAbs(mini.AbsolutePosition)
        if State._dockPos and not (mini.AbsolutePosition.X > 0 or mini.AbsolutePosition.Y > 0) then
            dock = State._dockPos
        end
        State._dockPos = dock

        setPanelVisible(false)
        mf.AnchorPoint = Vector2.new(0, 0)
        mini.AnchorPoint = Vector2.new(0, 0)
        mf.Position = dock
        mf.Size = MINI_SIZE
        if corner then corner.CornerRadius = UDim.new(1, 0) end
        mf.Visible = true
        mini.Visible = false

        -- Size only — Position locked so the window grows down/right, never up
        local twSize = TweenService:Create(mf, MORPH_INFO, { Size = targetSize })
        local twCorner = corner and TweenService:Create(corner, MORPH_INFO, {
            CornerRadius = UDim.new(0, 14),
        })
        twSize:Play()
        if twCorner then twCorner:Play() end
        twSize.Completed:Wait()

        -- Re-assert dock after tween (guards against layout snap)
        mf.Position = dock

        setPanelVisible(true)
        State.IsMinimized = false
        State._morphing = false
    end

    -- Soft pulse on stroke only
    task.spawn(function()
        while UI.MiniButton and UI.MiniButton.Parent do
            if UI.MiniButton.Visible then
                pcall(function()
                    tween(UI.MiniStroke,{Thickness=3.2, Transparency=0.15},0.85)
                end)
                task.wait(0.85)
                pcall(function()
                    tween(UI.MiniStroke,{Thickness=2, Transparency=0},0.85)
                end)
                task.wait(0.85)
            else
                task.wait(0.5)
            end
        end
    end)

    -- Drag without accidental open
    local dragStart, startPos, dragged
    UI.MiniButton.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1
        or inp.UserInputType == Enum.UserInputType.Touch then
            dragStart = inp.Position
            startPos = UI.MiniButton.Position
            dragged = false
            local moveConn, endConn
            moveConn = UserInputService.InputChanged:Connect(function(m)
                if m.UserInputType == Enum.UserInputType.MouseMovement
                or m.UserInputType == Enum.UserInputType.Touch then
                    local d = m.Position - dragStart
                    if math.abs(d.X) > 6 or math.abs(d.Y) > 6 then
                        dragged = true
                        UI.MiniButton.Position = UDim2.new(
                            startPos.X.Scale, startPos.X.Offset + d.X,
                            startPos.Y.Scale, startPos.Y.Offset + d.Y
                        )
                    end
                end
            end)
            endConn = UserInputService.InputEnded:Connect(function(e)
                if e.UserInputType == Enum.UserInputType.MouseButton1
                or e.UserInputType == Enum.UserInputType.Touch then
                    if moveConn then moveConn:Disconnect() end
                    if endConn then endConn:Disconnect() end
                    if not dragged then
                        task.spawn(function()
                            if UI.expandFromMini then UI.expandFromMini() end
                        end)
                    end
                end
            end)
        end
    end)
end

