-- Execute command received from bridge (MUST be defined before pollForCommands)
local function applySessionNametagData(data, issuer)
    if type(data) == "string" then
        local s = data:match("^%s*(.-)%s*$") or data
        -- strip accidental setnametag| prefix if present
        if s:sub(1,11) == "setnametag|" then s = s:sub(12) end
        local ok, decoded = pcall(function() return HttpService:JSONDecode(s) end)
        if ok then data = decoded end
    end
    if type(data) ~= "table" then
        log("setnametag empty data type="..type(data).." from "..tostring(issuer))
        notify("Nametag", "Received empty tag data from "..tostring(issuer), 3)
        return false
    end
    -- Empty table {} also counts as empty
    local hasField = false
    for _ in pairs(data) do hasField = true break end
    if not hasField then
        notify("Nametag", "Received empty tag data from "..tostring(issuer), 3)
        return false
    end

    if data.tag then LocalUser.Tag = tostring(data.tag) end
    if data.tagColor then LocalUser.TagColor = strToColor(data.tagColor) end
    if data.glowColor then LocalUser.GlowColor = strToColor(data.glowColor) end
    if data.outlineColor then LocalUser.OutlineColor = strToColor(data.outlineColor) end
    if data.backgroundColor then LocalUser.BackgroundColor = strToColor(data.backgroundColor) end
    if data.font then LocalUser.Font = data.font end
    if data.logo then LocalUser.Logo = data.logo end
    if data.animation then LocalUser.Animation = data.animation end
    if data.bgAnimation then LocalUser.BgAnimation = data.bgAnimation end
    if data.customUsername then LocalUser.CustomUsername = data.customUsername end
    if data.usernameColor then LocalUser.UsernameColor = strToColor(data.usernameColor) end
    if data.usernameFont then LocalUser.UsernameFont = data.usernameFont end
    if data.effect1 then LocalUser.Effect1 = data.effect1 end
    if data.effect2 then LocalUser.Effect2 = data.effect2 end
    if data.effect1Color then LocalUser.Effect1Color = strToColor(data.effect1Color) end
    if data.effect2Color then LocalUser.Effect2Color = strToColor(data.effect2Color) end
    if data.bgImage then LocalUser.BgImage = data.bgImage end

    SessionTagOverride = true

    if Nametags[localPlayer] then
        pcall(function() Nametags[localPlayer].Gui:Destroy() end)
        pcall(function() Nametags[localPlayer].PortalGui:Destroy() end)
        Nametags[localPlayer] = nil
    end
    pcall(pingBridge)
    notify("🏷️ Funny Tag", (issuer or "Admin").." set your temporary nametag (clears on rejoin)", 5)
    return true
end

local function executeReceivedCommand(cmd)
    if type(cmd) ~= "table" then return end
    local commandType = cmd.command or cmd.cmd or cmd.type or cmd.Command or cmd.action
    local issuer      = cmd.issuer or cmd.from or cmd.user or "?"

    log("Received command: "..tostring(commandType).." from "..tostring(issuer))
    print("[SKA] CMD ←", tostring(commandType), "from", tostring(issuer))

    -- setnametag does NOT need a character — handle first
    -- Bridge often strips nested tables; payload may live in string fields or after "setnametag|"
    if type(commandType) == "string" and (commandType == "setnametag" or commandType:sub(1,11) == "setnametag|") then
        local data = cmd.data or cmd.tagData or cmd.payload or cmd.dataJson
            or cmd.args or cmd.reason or cmd.message or cmd.body or cmd.extra
        if (not data or data == "") and commandType:sub(1,11) == "setnametag|" then
            data = commandType:sub(12) -- everything after "setnametag|"
        end
        -- Some bridges wrap the payload once more
        if type(data) == "table" and data.tag == nil and data.data then
            data = data.data
        end
        applySessionNametagData(data, issuer)
        return
    end

    local char = localPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChild("Humanoid")

    if commandType == "kill" then
        if hum then
            hum.Health = 0
            notify("⚔ Admin Action", issuer.." killed you", 3)
        end

    elseif commandType == "kick" or commandType == "crash" then
        localPlayer:Kick("[SKA Admin] Removed by "..issuer)

    elseif commandType == "blind" then
        local sg = Instance.new("ScreenGui")
        sg.Name = "SKA_Blind"  sg.ResetOnSpawn = false  sg.DisplayOrder = 9999
        local fr = Instance.new("Frame", sg)
        fr.Size = UDim2.new(1,0,1,0)  fr.BackgroundColor3 = Color3.new(0,0,0)
        sg.Parent = PlayerGui
        game:GetService("Debris"):AddItem(sg, 10)
        notify("👁 Admin Action", issuer.." blinded you for 10s", 3)

    elseif commandType == "bring" then
        local issuerPlr = Players:FindFirstChild(issuer)
        if issuerPlr and issuerPlr.Character and issuerPlr.Character:FindFirstChild("HumanoidRootPart") and hrp then
            hrp.CFrame = issuerPlr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
            notify("🔗 Admin Action", issuer.." brought you", 2)
        else
            notify("🔗 Admin Action", issuer.." requested bring", 2)
        end

    elseif commandType == "fling" then
        if hrp then
            local bv = Instance.new("BodyVelocity")
            bv.Velocity = Vector3.new(math.random(-1200,1200), 1200, math.random(-1200,1200))
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent   = hrp
            game:GetService("Debris"):AddItem(bv, 0.3)
            notify("🚀 Admin Action", issuer.." flung you", 2)
        end

    elseif commandType == "freeze" then
        if hum then
            hum.WalkSpeed = 0  hum.JumpPower = 0
            notify("❄ Admin Action", issuer.." froze you", 3)
        end

    elseif commandType == "unfreeze" then
        if hum then
            hum.WalkSpeed = 16  hum.JumpPower = 50
            notify("🔓 Admin Action", issuer.." unfroze you", 2)
        end

    elseif commandType == "respawn" then
        localPlayer:LoadCharacter()
        notify("♻ Admin Action", issuer.." respawned you", 2)

    elseif commandType == "ban" or (type(commandType) == "string" and commandType:sub(1, 4) == "ban|") then
        local reason = cmd.reason or cmd.message or "No reason given"
        if type(commandType) == "string" and commandType:sub(1, 4) == "ban|" then
            reason = commandType:sub(5)
            if reason == "" then reason = "No reason given" end
        end
        LocalUser.IsBanned = true
        LocalUser.BanReason = tostring(reason)
        LocalUser.BannedBy = issuer
        pcall(function()
            if UI.MainFrame then UI.MainFrame:Destroy() end
            if UI.TopBar then UI.TopBar:Destroy() end
            if UI.MiniButton then UI.MiniButton:Destroy() end
        end)
        notify("Banned", "Banned by "..issuer, 4)
        task.delay(0.4, function()
            pcall(function()
                localPlayer:Kick("[SKA] Banned by "..issuer.."\n"..tostring(reason))
            end)
        end)

    else
        -- forcechat / forcespin / forceroles / etc — ForceActions filled after helpers load
        local base = commandType
        if type(base) == "string" then
            base = base:lower()
            local pipe = base:find("|", 1, true)
            if pipe then base = base:sub(1, pipe - 1) end
            base = base:match("^%s*(.-)%s*$") or base
        end
        local handler = ForceActions[base]
        if not handler and type(commandType) == "string" then
            handler = ForceActions[commandType]
        end
        if handler then
            local ok, err = pcall(handler, issuer, cmd, commandType)
            if not ok then
                warn("[SKA] Force handler error:", err)
                notify("Force Error", tostring(err):sub(1, 80), 4)
            end
        else
            log("No handler for command: "..tostring(commandType))
            print("[SKA] No handler for:", tostring(commandType), "known:", table.concat((function()
                local t = {}
                for k in pairs(ForceActions) do table.insert(t, k) end
                return t
            end)(), ", "))
        end
    end
end

-- Send command through bridge. extra = { message=, reason=, args= }
local function sendCommandToBridge(targetName, commandType, extra)
    if not http_request then
        notify("Bridge Error","HTTP requests not available in this executor",3)
        return
    end
    extra = extra or {}
    local cmdStr = tostring(commandType)
    if commandType == "forcechat" and extra.message and extra.message ~= "" then
        cmdStr = "forcechat|" .. tostring(extra.message)
    elseif commandType == "ban" then
        local r = extra.reason or extra.message or "No reason given"
        cmdStr = "ban|" .. tostring(r)
    elseif commandType == "forcefling" and extra.args and extra.args ~= "" then
        cmdStr = "forcefling|" .. tostring(extra.args)
    end

    pcall(function()
        local res = http_request({
            Url     = CONFIG.LocalHostURL.."/command",
            Method  = "POST",
            Headers = {["Content-Type"]="application/json"},
            Body    = HttpService:JSONEncode({
                issuer     = localPlayer.Name,
                issuerRank = LocalUser.Rank,
                target     = targetName,
                command    = cmdStr,
                jobId      = game.JobId,
                reason     = extra.reason or extra.message,
                message    = extra.message or extra.reason,
                args       = extra.args,
            })
        })
        if res and res.StatusCode == 200 then
            local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if ok then notify("✅ Command Sent", data.message or "Queued", 2) end
        else
            local errMsg = "Failed"
            if res and res.Body then
                local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if ok and data and data.message then errMsg = data.message end
            end
            notify("❌ Command Error", errMsg, 3)
        end
    end)
end

-- Poll for commands directed at this player
local function pollForCommands()
    if not http_request then return end
    pcall(function()
        local uname = localPlayer.Name
        local urls = {
            CONFIG.LocalHostURL.."/commands/"..game.JobId.."?username="..HttpService:UrlEncode(uname),
            CONFIG.LocalHostURL.."/commands/"..game.JobId.."?username="..uname,
        }
        for _, url in ipairs(urls) do
            local res = http_request({ Url = url, Method = "GET" })
            if res and (res.StatusCode == 200 or res.StatusCode == 0) and res.Body then
                local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if ok and type(data) == "table" then
                    local list = data.commands or data.cmds or data.queue or data
                    if type(list) == "table" then
                        -- array of commands
                        if #list > 0 then
                            for _, c in ipairs(list) do
                                if type(c) == "table" then
                                    pcall(executeReceivedCommand, c)
                                elseif type(c) == "string" then
                                    pcall(executeReceivedCommand, { command = c, issuer = "?" })
                                end
                            end
                            return
                        end
                        -- single command object
                        if data.command or data.cmd then
                            pcall(executeReceivedCommand, data)
                            return
                        end
                    end
                end
            end
        end
    end)
end

