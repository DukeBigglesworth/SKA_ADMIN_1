-- EXECUTOR HTTP BRIDGE (With Cache-Bust Implementation)
-- ============================================================
local raw_http_request = (syn and syn.request)
    or (http and http.request)
    or (fluxus and fluxus.request)
    or (delta and delta.request)        -- Delta executor
    or (Delta and Delta.request)        -- Delta (capitalised)
    or (getgenv and getgenv().request)  -- some mobile executors
    or (request)
    or nil

-- Dynamic cache-busting wrapper to force-download updated JSON profiles
local function http_fetch(url, method)
    method = method or "GET"
    
    -- Inject millisecond-precision timestamp parameter to completely bypass CDN & client caching
    if method == "GET" then
        local connector = string.find(url, "%?") and "&" or "?"
        url = url .. connector .. "t=" .. tostring(tick())
    end

    -- Use game:HttpGet directly if available on your executor, fallback to HTTP request bodies
    if game and game.HttpGet then
        local success, result = pcall(function()
            return game:HttpGet(url)
        end)
        if success then return result end
    end

    if raw_http_request then
        local success, response = pcall(function()
            return raw_http_request({
                Url = url,
                Method = method,
                Headers = {
                    ["Cache-Control"] = "no-cache, no-store, must-revalidate",
                    ["Pragma"] = "no-cache",
                    ["Expires"] = "0"
                }
            })
        end)
        if success and response and response.Body then
            return response.Body
        end
    end
    
    return nil
end

