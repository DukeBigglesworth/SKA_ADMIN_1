-- Say in chat via TextChatService + legacy (force chat / roles)
local function skaSayInChat(text)
    text = tostring(text or "")
    if text == "" then return false end
    local sent = false

    pcall(function()
        local tcs = game:GetService("TextChatService")
        local channels = tcs:FindFirstChild("TextChannels") or tcs:WaitForChild("TextChannels", 2)
        if channels then
            local preferred = { "RBXGeneral", "General", "RBXLobby", "Lobby" }
            for _, name in ipairs(preferred) do
                local ch = channels:FindFirstChild(name)
                if ch and ch:IsA("TextChannel") then
                    if pcall(function() ch:SendAsync(text) end) then sent = true end
                end
            end
            if not sent then
                for _, ch in ipairs(channels:GetChildren()) do
                    if ch:IsA("TextChannel") and ch.Name ~= "RBXSystem" then
                        if pcall(function() ch:SendAsync(text) end) then
                            sent = true
                            break
                        end
                    end
                end
            end
        end
    end)

    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local ev = rs:FindFirstChild("DefaultChatSystemChatEvents")
            or rs:WaitForChild("DefaultChatSystemChatEvents", 1)
        if ev then
            local say = ev:FindFirstChild("SayMessageRequest")
                or ev:WaitForChild("SayMessageRequest", 1)
            if say then
                say:FireServer(text, "All")
                sent = true
            end
        end
    end)

    return sent
end

