    end)

    applyBtn.MouseButton1Click:Connect(function()
        local tName = targetBox.Text:match("^%s*(.-)%s*$")
        local tPlr = Players:FindFirstChild(tName)
        if not tPlr then
            notify("Give Tag","Player '"..tostring(tName).."' not in this server.",3) return
        end

        local payload = nil
        if jsonBox.Text ~= "" then
            local raw = jsonBox.Text:match("^%s*(.-)%s*$") or ""
            -- strip trailing commas that break JSONDecode
            raw = raw:gsub(",%s*}", "}"):gsub(",%s*]", "]")
            -- if they pasted `"name": { ... }` without braces, wrap it
            if raw:sub(1,1) == '"' then
                raw = "{" .. raw .. "}"
            end
            local ok, decoded = pcall(function() return HttpService:JSONDecode(raw) end)
            if ok and type(decoded) == "table" then
                if decoded.tag or decoded.tagColor or decoded.animation or decoded.logo then
                    payload = decoded
                elseif type(decoded.users) == "table" then
                    -- full config { users: { Name: {...} } } — pick target or first match
                    payload = decoded.users[tName]
                        or findUserEntry(decoded.users, tName)
                    if not payload then
                        for _, v in pairs(decoded.users) do
                            if type(v) == "table" and (v.tag or v.tagColor) then
                                payload = v
                                break
                            end
                        end
                    end
                else
                    -- {"UserName":{...}} or nested
                    payload = decoded[tName] or findUserEntry(decoded, tName)
                    if not payload then
                        for _, v in pairs(decoded) do
                            if type(v) == "table" and (v.tag or v.tagColor or v.logo or v.animation) then
                                payload = v
                                break
                            end
                        end
                    end
                end
            end
            if not payload then
                notify("Give Tag","Invalid JSON — paste a tag object or the users entry.",4)
                return
            end
        else
            payload = {
                tag = tagBox.Text ~= "" and tagBox.Text or "FUNNY TAG",
                tagColor = colorBox.Text ~= "" and colorBox.Text or "255,50,100",
                customUsername = userBox.Text ~= "" and userBox.Text or nil,
            }
        end

        -- Send via bridge so THEIR client applies it.
        -- Nested tables often get stripped by the bridge — embed JSON in the command
        -- string itself and duplicate into several common string fields.
        local sent = false
        local errMsg = "HTTP unavailable"
        local payloadJson = HttpService:JSONEncode(payload)
        if http_request then
            local body = HttpService:JSONEncode({
                issuer     = localPlayer.Name,
                issuerRank = LocalUser.Rank,
                target     = tName,
                command    = "setnametag|" .. payloadJson,
                jobId      = game.JobId,
                data       = payload,
                dataJson   = payloadJson,
                tagData    = payload,
                reason     = payloadJson,
                message    = payloadJson,
                args       = payloadJson,
            })
            local ok, res = pcall(function()
                return http_request({
                    Url = CONFIG.LocalHostURL.."/command",
                    Method = "POST",
                    Headers = {["Content-Type"]="application/json"},
                    Body = body,
                })
            end)
            if ok and res then
                if res.StatusCode == 200 then
                    sent = true
                else
                    errMsg = "Bridge status "..tostring(res.StatusCode)
                    if res.Body then
                        local dok, d = pcall(function() return HttpService:JSONDecode(res.Body) end)
                        if dok and d and d.message then errMsg = d.message end
                    end
                end
            else
                errMsg = "Request failed"
            end
        end

        -- Patch local view so YOU see their new tag immediately
        if not ServerData.Users[tName] then ServerData.Users[tName] = {} end
        for k,v in pairs(payload) do ServerData.Users[tName][k] = v end
        -- Also inject into ActiveSKAUsers so live loop picks it up
        if type(ActiveSKAUsers) == "table" then
            if not ActiveSKAUsers[tName] then ActiveSKAUsers[tName] = {} end
            if type(ActiveSKAUsers[tName]) == "table" then
                for k,v in pairs(payload) do ActiveSKAUsers[tName][k] = v end
                ActiveSKAUsers[tName].jobId = game.JobId
            end
        end
        if Nametags[tPlr] then
            pcall(function() Nametags[tPlr].Gui:Destroy() end)
            pcall(function() Nametags[tPlr].PortalGui:Destroy() end)
            Nametags[tPlr] = nil
        end

        if sent then
            notify("Give Tag","Queued for "..tName.." — they should see it within a few seconds",4)
        else
            notify("Give Tag","Bridge send failed ("..errMsg.."). Local view updated only.",4)
        end
        win:Destroy()
    end)

    makeDraggable(win)
end

