local function getPredictedPosition(player, offset)
    offset = offset or State.ShootOffset
    local char = player and player.Character
    if not char then return Vector3.zero end
    local part = char:FindFirstChild("UpperTorso") or char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not part or not hum then return Vector3.zero end
    local velocity = part.AssemblyLinearVelocity
    local moveDir = hum.MoveDirection
    local predicted = part.Position
        + (velocity * Vector3.new(0.75, 0.5, 0.75)) * (offset / 15)
        + moveDir * offset
    local pingFactor = ((localPlayer:GetNetworkPing() * 1000) * ((State.OffsetPingMult - 1) * 0.01)) + 1
    return predicted * pingFactor
end

local function equipTool(name)
    local char = localPlayer.Character
    if not char then return false end
    if char:FindFirstChild(name) then return true end
    local bp = localPlayer:FindFirstChild("Backpack")
    local tool = bp and bp:FindFirstChild(name)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if tool and hum then
        hum:EquipTool(tool)
        task.wait(0.15)
        return char:FindFirstChild(name) ~= nil
    end
    return false
end

local function shootMurderer()
    if findSheriff() ~= localPlayer then
        notify("MM2", "You're not sheriff/hero.", 2)
        return
    end
    local target = findMurderer() or findSheriffNotMe()
    if not target or not target.Character then
        notify("MM2", "No murderer to shoot.", 2)
        return
    end
    if not equipTool("Gun") then
        notify("MM2", "You don't have the gun.", 2)
        return
    end
    local gun = localPlayer.Character:FindFirstChild("Gun")
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not gun or not hrp then return end

    local predicted = getPredictedPosition(target, State.ShootOffset)
    local args
    if State.InstaKillShoot then
        args = {
            CFrame.new(hrp.Position + Vector3.new(0, 1, 0)),
            CFrame.new(hrp.Position),
        }
    else
        local hand = localPlayer.Character:FindFirstChild("RightHand")
        args = {
            CFrame.new(hand and hand.Position or localPlayer.Character.HumanoidRootPart.Position),
            CFrame.new(predicted),
        }
    end
    pcall(function()
