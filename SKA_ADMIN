        reason = commandType:sub(5)
    else
        reason = tostring(cmd.reason or cmd.message or reason)
    end
    LocalUser.IsBanned = true
    LocalUser.BanReason = reason
    LocalUser.BannedBy = issuer
    pcall(function()
        if UI.MainFrame then UI.MainFrame:Destroy() end
        if UI.MiniButton then UI.MiniButton:Destroy() end
    end)
    task.delay(0.3, function()
        pcall(function() localPlayer:Kick("[SKA] Banned by "..tostring(issuer).."\n"..reason) end)
    end)
end

local function setRoundTimer(on)
    State.RoundTimer = on
    if MM2.TimerLabel then
        pcall(function() MM2.TimerLabel:Destroy() end)
        MM2.TimerLabel = nil
    end
    if MM2.TimerTask then
        task.cancel(MM2.TimerTask)
        MM2.TimerTask = nil
    end
    if not on then return end
    local lbl = Instance.new("TextLabel")
    lbl.Name = "SKA_RoundTimer"
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.new(1, 1, 1)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 22
    lbl.AnchorPoint = Vector2.new(0.5, 0)
    lbl.Position = UDim2.new(0.5, 0, 0, 50)
    lbl.Size = UDim2.new(0, 220, 0, 36)
    lbl.Text = "--"
    lbl.Parent = UI.ScreenGui or PlayerGui
    MM2.TimerLabel = lbl
    MM2.TimerTask = task.spawn(function()
        while State.RoundTimer and lbl.Parent do
            local ok, timeLeft = pcall(function()
                return game.ReplicatedStorage.Remotes.Extras.GetTimer:InvokeServer()
            end)
            if ok and type(timeLeft) == "number" and timeLeft >= 0 then
                local m = math.floor(timeLeft / 60)
                local s = timeLeft % 60
                lbl.Text = string.format("%dm %02ds", m, s)
            else
                lbl.Text = "--"
            end
            task.wait(0.5)
        end
    end)
end

