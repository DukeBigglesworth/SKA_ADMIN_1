    local flyActive = false

    -- Short aliases → full command
    local CMD_ALIASES = {
        b = "bring", br = "bring", bring = "bring",
        ub = "unbring", unbring = "unbring", stopbring = "unbring",
        k = "kill", kill = "kill",
        c = "crash", crash = "crash",
        r = "respawn", rs = "respawn", respawn = "respawn",
        f = "fling", fl = "fling", fling = "fling",
        lf = "lfling", lfling = "lfling", flingplayer = "lfling",
        bl = "blind", blind = "blind",
        fr = "freeze", freeze = "freeze",
        uf = "unfreeze", unfreeze = "unfreeze",
        tp = "goto", to = "goto", goto = "goto", teleport = "goto",
        e = "esp", esp = "esp",
        fb = "fullbright", fullbright = "fullbright",
        fly = "fly", unfly = "unfly", nofly = "unfly",
        nc = "noclip", noclip = "noclip",
        s = "spin", spin = "spin",
        rk = "rocket", rocket = "rocket",
        j = "jump", jump = "jump", jumpspam = "jump",
        sh = "shoot", shoot = "shoot",
        th = "throw", throw = "throw", knifethrow = "throw",
        ka = "killaura", killaura = "killaura",
        roles = "roles",
        gg = "discord", discord = "discord",
        nt = "nametag", nametag = "nametag",
        rj = "rejoin", rej = "rejoin", rejoin = "rejoin",
        h = "help", help = "help", ["?"] = "help",
    }

    local function runCommand(raw)
        raw = tostring(raw or ""):match("^%s*(.-)%s*$") or ""
        -- strip leading ; ! / .
        raw = raw:gsub("^[;!/%.]+%s*", "")
        if raw == "" then return end

        local parts = {}
        for w in raw:gmatch("%S+") do table.insert(parts, w) end
        local rawCmd = parts[1] and parts[1]:lower() or ""
        local cmd = CMD_ALIASES[rawCmd] or rawCmd
        -- everything after command = target (supports display names with spaces)
        local arg = table.concat(parts, " ", 2)

        local function needPlayer()
            if arg == "" then
                consoleOut("Usage: "..rawCmd.." <username|display>", Theme.Murderer)
                return nil
            end
            local tPlr = findPlayerFlexible(arg)
            if not tPlr then
                consoleOut("Player not found: "..arg, Theme.Murderer)
                return nil
            end
            return tPlr
        end

        if cmd == "fly" then
            if not flyActive then
                flyActive=true State.FlyActive=true
                enableFly() consoleOut("Fly ON",Theme.Alive) updateStatus()
            end

        elseif cmd == "unfly" then
            if flyActive then
                flyActive=false State.FlyActive=false
                disableFly() consoleOut("Fly OFF",Theme.Murderer) updateStatus()
            end

        elseif cmd == "esp" then
            local on = arg:lower()~="off"
            State.ESPEnabled = on
            if on then
                updateESP()
                task.spawn(function()
                    while State.ESPEnabled do updateESP() task.wait(0.5) end
                end)
            else
                for plr, hl in pairs(Highlights) do
                    pcall(function() if hl then hl:Destroy() end end)
                    Highlights[plr] = nil
                end
                Highlights = {}
            end
            updateStatus()
            consoleOut("ESP "..(on and "ON" or "OFF"))

        elseif cmd == "fullbright" then
            local on = arg:lower()~="off"
            State.Fullbright = on
            Lighting.Ambient    = on and Color3.new(1,1,1) or Color3.fromRGB(70,70,70)
            Lighting.Brightness = on and 2 or 1
            consoleOut("Fullbright "..(on and "ON" or "OFF"))

        elseif cmd == "bring" then
            if arg == "" then
                if LocalUser.Rank < 1 then consoleOut("No permission",Theme.Murderer) return end
                State.BringActive = true
                if Connections.Bring then Connections.Bring:Disconnect() end
                Connections.Bring = RunService.Heartbeat:Connect(bringAll)
                _G.SKA_BRING_CONN = Connections.Bring
                consoleOut("Bring All ON",Theme.Alive)
            else
                if LocalUser.Rank < 1 then consoleOut("No permission",Theme.Murderer) return end
                local tPlr = needPlayer()
                if not tPlr then return end
                executeCommand(tPlr,"bring")
                consoleOut("Brought "..tPlr.Name)
            end
            updateStatus()

        elseif cmd == "unbring" then
            State.BringActive = false
            if Connections.Bring then Connections.Bring:Disconnect() Connections.Bring=nil end
            updateStatus()
            consoleOut("Bring stopped")

        elseif cmd == "kill" then
            if LocalUser.Rank < 2 then consoleOut("Requires Admin rank",Theme.Murderer) return end
            local tPlr = needPlayer()
            if not tPlr then return end
            executeCommand(tPlr,"kill")
            consoleOut("Killed "..tPlr.Name, Theme.Murderer)

        elseif cmd == "crash" then
            if LocalUser.Rank < 2 then consoleOut("Requires Admin rank",Theme.Murderer) return end
            local tPlr = needPlayer()
            if not tPlr then return end
            executeCommand(tPlr,"crash")
            consoleOut("Crashed "..tPlr.Name, Theme.Murderer)

        elseif cmd == "respawn" then
            if LocalUser.Rank < 2 then consoleOut("Requires Admin rank",Theme.Murderer) return end
            local tPlr = needPlayer()
            if not tPlr then return end
            executeCommand(tPlr,"respawn")
            consoleOut("Respawned "..tPlr.Name)

        elseif cmd == "fling" then
            -- Admin fling via bridge (premium+)
            if LocalUser.Rank < 1 then consoleOut("Requires Premium rank",Theme.Murderer) return end
            local tPlr = needPlayer()
            if not tPlr then return end
            executeCommand(tPlr,"fling")
            consoleOut("Flung "..tPlr.Name)

        elseif cmd == "lfling" then
            -- Local troll fling — any player, premium+
            if LocalUser.Rank < 1 then consoleOut("Requires Premium rank",Theme.Murderer) return end
            local tPlr = needPlayer()
            if not tPlr then return end
            flingPlayerLocal(tPlr)
            consoleOut("Flinging "..tPlr.Name)

        elseif cmd == "blind" then
            if LocalUser.Rank < 1 then consoleOut("Requires Premium rank",Theme.Murderer) return end
            local tPlr = needPlayer()
            if not tPlr then return end
            executeCommand(tPlr,"blind")
            consoleOut("Blinded "..tPlr.Name)

        elseif cmd == "freeze" then
            if LocalUser.Rank < 1 then consoleOut("Requires Premium rank",Theme.Murderer) return end
            local tPlr = needPlayer()
            if not tPlr then return end
            executeCommand(tPlr,"freeze")
            consoleOut("Froze "..tPlr.Name)

        elseif cmd == "unfreeze" then
            if LocalUser.Rank < 1 then consoleOut("Requires Premium rank",Theme.Murderer) return end
            local tPlr = needPlayer()
            if not tPlr then return end
            executeCommand(tPlr,"unfreeze")
            consoleOut("Unfroze "..tPlr.Name)

        elseif cmd == "goto" then
            local tPlr = needPlayer()
            if not tPlr or not tPlr.Character then return end
            local myHRP = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tgHRP = tPlr.Character:FindFirstChild("HumanoidRootPart")
            if myHRP and tgHRP then
                myHRP.CFrame = tgHRP.CFrame * CFrame.new(0, 0, 4)
                consoleOut("Went to "..tPlr.Name.." ("..tPlr.DisplayName..")")
            else
                consoleOut("Target has no character", Theme.Murderer)
            end

        elseif cmd == "rejoin" then
            consoleOut("Rejoining…")
            notify("Rejoin", "Teleporting back to this game…", 2)
            task.spawn(function()
                local ok = pcall(function()
                    -- Prefer same server instance when possible
                    TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, localPlayer)
                end)
                if not ok then
                    pcall(function()
                        TeleportService:Teleport(game.PlaceId, localPlayer)
                    end)
                end
            end)

        elseif cmd == "spin" then
            spinSelf(tonumber(arg) or 3)
            consoleOut("Spinning")

        elseif cmd == "rocket" then
            rocketSelf()
            consoleOut("Rocket")

        elseif cmd == "noclip" then
            noclipToggle()
            consoleOut("Noclip toggled")

        elseif cmd == "jump" then
            danceSpam()
            consoleOut("Jump spam")

        elseif cmd == "shoot" then
            shootMurderer()
            consoleOut("Shoot murderer")

        elseif cmd == "throw" then
            knifeThrow(false)
            consoleOut("Knife throw")

        elseif cmd == "killaura" then
            local on = arg:lower() ~= "off"
            setKillAura(on)
            consoleOut("Kill aura "..(on and "ON" or "OFF"))

        elseif cmd == "roles" then
            announceRoles()
            consoleOut("Roles announced")

        elseif cmd == "discord" then
            consoleOut("Join: "..tostring(CONFIG.DiscordInvite), Theme.Accent)
            if setclipboard then setclipboard(CONFIG.DiscordInvite) end

        elseif cmd == "nametag" then
            if openNametagEditor then openNametagEditor()
            else consoleOut("Editor not ready",Theme.Murderer) end

        elseif cmd == "help" then
            consoleOut("!b/!bring  !goto/!tp  !rj/!rejoin  !f fling  !lf  !k kill  !fb  !e esp  !fly  !h help")

        else
            consoleOut("Unknown: "..rawCmd.."  (!help / ;help)", Theme.Murderer)
        end
    end

    -- Expose for MainFrame cmd bar + chat
    _G.SKA_runCommand = runCommand

    -- ============================================================
    -- CHAT COMMANDS  (!bring Name  /  !b DisplayName  /  ;goto x)
    -- ============================================================
    local function handleChatMessage(msg)
        if type(msg) ~= "string" then return end
        msg = msg:match("^%s*(.-)%s*$") or ""
        -- Only treat messages starting with ! ; / . as commands
        local first = msg:sub(1, 1)
        if first ~= "!" and first ~= ";" and first ~= "/" and first ~= "." then
            return
        end
        runCommand(msg)
    end

    -- Legacy chat
    pcall(function()
        localPlayer.Chatted:Connect(handleChatMessage)
    end)

    -- TextChatService (new Roblox chat)
    pcall(function()
        local TextChat = game:GetService("TextChatService")
        if TextChat then
            if TextChat.MessageReceived then
                TextChat.MessageReceived:Connect(function(message)
                    local src = message.TextSource
                    if src and src.UserId == localPlayer.UserId then
                        handleChatMessage(message.Text)
                    end
                end)
            end
            -- Sending path (fires for local player in some clients)
            local channels = TextChat:FindFirstChild("TextChannels")
            if channels then
                for _, ch in ipairs(channels:GetChildren()) do
                    if ch:IsA("TextChannel") then
                        ch.MessageReceived:Connect(function(message)
                            local src = message.TextSource
                            if src and src.UserId == localPlayer.UserId then
                                handleChatMessage(message.Text)
                            end
                        end)
                    end
                end
            end
        end
    end)

    inputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            runCommand(inputBox.Text)
            inputBox.Text = ""
        end
    end)

    -- Toggle on Left Alt (desktop)
    UserInputService.InputBegan:Connect(function(inp, gameProcessed)
        if gameProcessed then return end
        if inp.KeyCode == Enum.KeyCode.LeftAlt then
            local nowVisible = not bg.Visible
            bg.Visible = nowVisible
            if nowVisible then
                inputBox.Text = ""
                inputBox:CaptureFocus()
            else
                outBg.Visible = false
            end
        end
        if inp.KeyCode == Enum.KeyCode.Escape and bg.Visible then
            bg.Visible = false
            outBg.Visible = false
        end
    end)

    -- Wire MainFrame bottom command bar (lives on the UI, not the screen)
    if UI.CmdBox then
        local function runMainCmd()
            local txt = UI.CmdBox.Text:match("^%s*(.-)%s*$")
            if txt ~= "" then
                runCommand(txt)
                UI.CmdBox.Text = ""
            end
        end
        UI.CmdBox.FocusLost:Connect(function(enter)
            if enter then runMainCmd() end
        end)
        local goBtn = UI.CmdBar and UI.CmdBar:FindFirstChildWhichIsA("TextButton")
        if goBtn then
            goBtn.MouseButton1Click:Connect(runMainCmd)
        end
    end

    return consoleGui
end

