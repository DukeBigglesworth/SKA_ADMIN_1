    inputBox.BackgroundTransparency = 1
    inputBox.PlaceholderText = "Type a message..."
    inputBox.Text = ""  inputBox.TextColor3 = Theme.Text
    inputBox.Font = Enum.Font.Gotham  inputBox.TextSize = 12
    inputBox.ClearTextOnFocus = false  inputBox.TextWrapped = true
    inputBox.MultiLine = false  inputBox.TextXAlignment = Enum.TextXAlignment.Left

    local sendBtn = Instance.new("TextButton", inputBG)
    sendBtn.Size = UDim2.new(0,56,1,-16)  sendBtn.Position = UDim2.new(1,-62,0,8)
    sendBtn.BackgroundColor3 = Theme.Accent  sendBtn.Text = "Send"
    sendBtn.TextColor3 = Color3.new(1,1,1)  sendBtn.Font = Enum.Font.GothamBold
    sendBtn.TextSize = 12  sendBtn.AutoButtonColor = false
    Instance.new("UICorner",sendBtn).CornerRadius = UDim.new(0,6)
    sendBtn.MouseEnter:Connect(function() tween(sendBtn,{BackgroundColor3=Theme.Accent:Lerp(Color3.new(1,1,1),0.15)},0.12) end)
    sendBtn.MouseLeave:Connect(function() tween(sendBtn,{BackgroundColor3=Theme.Accent},0.12) end)

    -- ── Message list ─────────────────────────────────────────
    local listFrame = Instance.new("ScrollingFrame", panel)
    listFrame.Name = "ChatList"
    listFrame.Size = UDim2.new(1,-10,1,-110)  listFrame.Position = UDim2.new(0,5,0,40)
    listFrame.BackgroundColor3 = Theme.BackgroundSecondary  listFrame.BorderSizePixel = 0
    listFrame.ScrollBarThickness = 4  listFrame.CanvasSize = UDim2.new(0,0,0,0)
    listFrame.ScrollingDirection = Enum.ScrollingDirection.Y
    Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0,8)
    local listLayout = Instance.new("UIListLayout", listFrame)
    listLayout.Padding = UDim.new(0,2)  listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    local listPad = Instance.new("UIPadding", listFrame)
    listPad.PaddingLeft = UDim.new(0,6)  listPad.PaddingRight = UDim.new(0,6)
    listPad.PaddingTop = UDim.new(0,4)   listPad.PaddingBottom = UDim.new(0,4)

    -- Empty-state label
    local emptyLbl = Instance.new("TextLabel", listFrame)
    emptyLbl.Name = "EmptyLbl"
    emptyLbl.Size = UDim2.new(1,-12,0,40)  emptyLbl.Position = UDim2.new(0,6,0,8)
    emptyLbl.BackgroundTransparency = 1
    emptyLbl.Text = "No messages yet. Switch mode or say something!"
    emptyLbl.TextColor3 = Theme.TextDim  emptyLbl.Font = Enum.Font.Gotham
    emptyLbl.TextSize = 11  emptyLbl.TextWrapped = true
    emptyLbl.TextXAlignment = Enum.TextXAlignment.Center
    emptyLbl.LayoutOrder = 999999

    -- Helper: add one message row to the list
    local function addMessageRow(msg)
        if emptyLbl and emptyLbl.Parent then emptyLbl:Destroy() end

        local rank       = msg.rank or 0
        local dispName   = msg.displayName or msg.username or "?"
        local username   = msg.username or "?"
        local rankLabel  = RANK_LABEL[rank]  or "SKA Free"
        local rankColor  = RANK_CHAT_COLOR[rank] or Color3.fromRGB(160,160,160)
        local msgText    = msg.message or ""

        local row = Instance.new("Frame", listFrame)
        row.Size = UDim2.new(1,-8,0,0)  -- height auto-set below
        row.BackgroundTransparency = 1  row.BorderSizePixel = 0
        row.LayoutOrder = math.floor((msg.timestamp or 0) * 1000)
        row.AutomaticSize = Enum.AutomaticSize.Y

        -- Rank colour bar on left
        local bar = Instance.new("Frame", row)
        bar.Size = UDim2.new(0,3,1,0)  bar.BackgroundColor3 = rankColor  bar.BorderSizePixel = 0
        Instance.new("UICorner",bar).CornerRadius = UDim.new(0,2)

        -- Header: "DisplayName" (SKA Rank)
        local header = Instance.new("TextLabel", row)
        header.Size = UDim2.new(1,-10,0,16)  header.Position = UDim2.new(0,9,0,2)
        header.BackgroundTransparency = 1
        header.Text = '"'..dispName..'" ('..rankLabel..')'
        header.TextColor3 = rankColor  header.Font = Enum.Font.GothamBold
        header.TextSize = 10  header.TextXAlignment = Enum.TextXAlignment.Left

        -- Message body
        local body = Instance.new("TextLabel", row)
        body.Size = UDim2.new(1,-10,0,0)  body.Position = UDim2.new(0,9,0,18)
        body.BackgroundTransparency = 1  body.AutomaticSize = Enum.AutomaticSize.Y
        body.Text = msgText  body.TextColor3 = Theme.Text
        body.Font = Enum.Font.Gotham  body.TextSize = 11
        body.TextWrapped = true  body.TextXAlignment = Enum.TextXAlignment.Left

        table.insert(msgRows, row)

        -- Auto-scroll to bottom
        task.defer(function()
            local canvas = listLayout.AbsoluteContentSize.Y + 8
            listFrame.CanvasSize = UDim2.new(0,0,0,canvas)
            listFrame.CanvasPosition = Vector2.new(0, math.max(0, canvas - listFrame.AbsoluteSize.Y))
        end)
    end

    -- ── Mode switching logic ──────────────────────────────────
    local function switchMode(key)
        currentMode   = key
        lastTimestamp = 0   -- reset so we fetch recent history on mode change
        -- Clear existing messages
        for _, r in ipairs(msgRows) do pcall(function() r:Destroy() end) end
        msgRows = {}
        -- Re-add empty label
        if not listFrame:FindFirstChild("EmptyLbl") then
            local el = Instance.new("TextLabel", listFrame)
            el.Name = "EmptyLbl"  el.Size = UDim2.new(1,-12,0,40)  el.Position = UDim2.new(0,6,0,8)
            el.BackgroundTransparency = 1
            el.Text = "No messages yet. Switch mode or say something!"
            el.TextColor3 = Theme.TextDim  el.Font = Enum.Font.Gotham
            el.TextSize = 11  el.TextWrapped = true
            el.TextXAlignment = Enum.TextXAlignment.Center  el.LayoutOrder = 999999
        end
        -- Update button highlights
        for k, b in pairs(modeButtons) do
            b.BackgroundColor3 = (k==key) and Theme.Accent or Theme.BackgroundSecondary
            b.TextColor3       = (k==key) and Color3.new(1,1,1) or Theme.TextDim
        end
    end

    for _, md in ipairs(modeDefs) do
        local key = md.Key
        modeButtons[key].MouseButton1Click:Connect(function() switchMode(key) end)
    end

    -- ── Send message ─────────────────────────────────────────
    local function sendMessage()
        if not http_request then
            notify("Chat","Bridge unavailable — HTTP not supported by this executor",3) return
        end
        local txt = inputBox.Text:match("^%s*(.-)%s*$")
        if txt == "" then return end
        inputBox.Text = ""

        pcall(function()
            http_request({
                Url     = CONFIG.LocalHostURL.."/chat/send",
                Method  = "POST",
                Headers = {["Content-Type"]="application/json"},
                Body    = HttpService:JSONEncode({
                    username    = localPlayer.Name,
                    displayName = localPlayer.DisplayName,
                    rank        = LocalUser.Rank,
                    message     = txt,
                    mode        = currentMode,
                    jobId       = game.JobId,
                    placeId     = tostring(game.PlaceId),
                })
            })
        end)
    end

    -- Wire up input box (already created above listFrame)
    sendBtn.MouseButton1Click:Connect(sendMessage)
    inputBox.FocusLost:Connect(function(enter)
        if enter then sendMessage() end
    end)

    -- ── Auto-polling loop (every 3s, fully automatic) ────────
    task.spawn(function()
        while panel and panel.Parent do
            task.wait(3)
            if not http_request then continue end
            -- Only poll if the Chat tab is visible (panel.Visible) to save requests
            -- But we always poll so messages don't pile up when user switches tabs
            pcall(function()
                local params = "?mode="..currentMode.."&since="..string.format("%.3f", lastTimestamp)
                if currentMode == "server" then
                    params = params.."&jobId="..game.JobId
                elseif currentMode == "game" then
                    params = params.."&placeId="..tostring(game.PlaceId)
                end
                local res = http_request({ Url=CONFIG.LocalHostURL.."/chat/get"..params, Method="GET" })
                if res and res.StatusCode == 200 and res.Body then
                    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                    if ok and data.messages and #data.messages > 0 then
                        for _, msg in ipairs(data.messages) do
                            if (msg.timestamp or 0) > lastTimestamp then
                                lastTimestamp = msg.timestamp
                                addMessageRow(msg)
                            end
                        end
                    end
                end
            end)
        end
    end)

    -- Chat panel must NOT scroll as a whole — only the message list scrolls.
    -- Input bar is positionally fixed at the bottom of the visible area.
    panel.CanvasSize = UDim2.new(0, 0, 0, 0)
    panel.ScrollingEnabled = false
    panel.ScrollBarThickness = 0
end

local function initialize()
    -- Build UI
    createMainUI()
    createMiniButton()
    createTopBar()
    buildCombatPanel()
    buildVisualsPanel()
    buildMM2Panel()
    buildTrollingPanel()
    buildAdminPanel()
    buildChatPanel()
    buildSettingsPanel()
    buildCreditsPanel()
    createAltConsole()

    -- Nametag loop
    RunService.RenderStepped:Connect(updateNametags)

    -- Clean up on leave
    Players.PlayerRemoving:Connect(function(plr)
        destroyNametag(plr)
        if Highlights[plr] then
            pcall(function() Highlights[plr]:Destroy() end)
            Highlights[plr] = nil
        end
    end)

    -- Hook EVERY player (including ones already in the server) so death/respawn rebuilds tags
    local function hookNametagRespawn(plr)
        plr.CharacterRemoving:Connect(function()
            destroyNametag(plr)
        end)
        plr.CharacterAdded:Connect(function(char)
            destroyNametag(plr)
            -- Wait for Head so createNametag can adornee correctly
            local head = char:FindFirstChild("Head") or char:WaitForChild("Head", 5)
            if head and isSKAPlayer(plr) then
                task.defer(function()
                    if not Nametags[plr] and plr.Character and plr.Character:FindFirstChild("Head") then
                        local ok, result = pcall(function() return createNametag(plr) end)
                        if ok and result then
                            Nametags[plr] = result
                        end
                    end
                end)
            end
        end)
        -- If they already have a character, ensure tag exists
        if plr.Character and plr.Character:FindFirstChild("Head") and isSKAPlayer(plr) then
            if not Nametags[plr] then
                local ok, result = pcall(function() return createNametag(plr) end)
                if ok and result then Nametags[plr] = result end
            end
        end
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        hookNametagRespawn(plr)
    end
    Players.PlayerAdded:Connect(hookNametagRespawn)

    -- Apply initial theme
    applyTheme()
    updateStatus()

    -- RightShift toggles main UI with same morph animation
    UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if inp.KeyCode == Enum.KeyCode.RightShift then
            if not UI.MainFrame then return end
            task.spawn(function()
                if UI.MainFrame.Visible then
                    if UI.shrinkToMini then UI.shrinkToMini() end
                else
                    if UI.expandFromMini then UI.expandFromMini() end
                end
            end)
        end
    end)

    -- Ban / rank check after data loads
    task.delay(2, function()
        -- Re-fetch once more in case first attempt raced
        fetchGitHub()
        task.wait(0.5)
        if LocalUser.IsBanned then
            local msg = string.format(
                "Banned from SKA by %s\nReason: %s",
                tostring(LocalUser.BannedBy or "an admin"),
                tostring(LocalUser.BanReason or "No reason given")
            )
            -- Destroy UI then kick
            pcall(function()
                if UI.MainFrame then UI.MainFrame:Destroy() end
                if UI.TopBar    then UI.TopBar:Destroy()    end
                if UI.MiniButton then UI.MiniButton:Destroy() end
            end)
            pcall(function() localPlayer:Kick(msg) end)
        else
            local tag = (RANK_INFO[LocalUser.Rank] and RANK_INFO[LocalUser.Rank].Tag) or LocalUser.Tag
            notify("SKA Admin","v9.4 loaded  ·  "..tostring(tag), 4)
            log("Init complete — Rank="..tostring(LocalUser.Rank).." Tag="..tostring(LocalUser.Tag))
        end
    end)

    -- Global stop: disables ALL toggles so hot-reload / loader update is clean
    local function skaStopAll()
        State.BringActive = false
        State.BringMurdererOnly = false
        State.ESPEnabled = false
        State.Fullbright = false
        State.FlyActive = false
        State.KillAura = false
        State.AutoKnifeThrow = false
        State.AutoShoot = false
        State.GunDropESP = false
        State.TrapESP = false
        State.Spectating = false
        State.RoundTimer = false

        for name, conn in pairs(Connections) do
            pcall(function() if conn and conn.Disconnect then conn:Disconnect() end end)
            Connections[name] = nil
        end
        pcall(function() if _G.SKA_BRING_CONN then _G.SKA_BRING_CONN:Disconnect() end end)
        _G.SKA_BRING_CONN = nil
        pcall(function() if MM2 and MM2.KillAuraConn then MM2.KillAuraConn:Disconnect() MM2.KillAuraConn = nil end end)
        pcall(function() if disableFly then disableFly() end end)

        for plr, hl in pairs(Highlights) do
            pcall(function() if hl then hl:Destroy() end end)
            Highlights[plr] = nil
        end

        pcall(function()
            local cam = workspace.CurrentCamera
            if localPlayer.Character then
                local hum = localPlayer.Character:FindFirstChildOfClass("Humanoid")
                if hum then cam.CameraSubject = hum end
            end
        end)

        print("[SKA] skaStopAll — toggles cleared")
    end

    if getgenv then
        getgenv().SKA_STOP = skaStopAll
    end
    _G.SKA_STOP = skaStopAll

    print("[SKA] v10.3 initialized — "..localPlayer.Name)
end

initialize()
