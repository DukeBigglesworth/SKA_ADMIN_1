local function hasPermission(cmd)
    if LocalUser.IsBanned then return false end
    if LocalUser.Rank == 3 then return true end
    local allowed = LocalUser.AllowedCommands or {}
    if table.find(allowed,"all") then return true end
    return table.find(allowed, cmd) ~= nil
end

local function canTarget(targetName)
    if LocalUser.IsBanned then return false end
    if LocalUser.Rank == 3 then return true end
    local entry = findUserEntry(ServerData.Users, targetName)
    local targetRank = (entry and tonumber(entry.rank)) or 0
    if LocalUser.Rank == 2 and targetRank < 2 then return true end
    if LocalUser.Rank == 1 and targetRank < 1 then return true end
    return false
end

local function getUserRank(name)
    -- Prefer live bridge data (same server), then GitHub JSON
    local bridge = ActiveSKAUsers[name] or findUserEntry(ActiveSKAUsers, name)
    if bridge and bridge.rank ~= nil then
        return tonumber(bridge.rank) or 0
    end
    local d = findUserEntry(ServerData.Users, name)
    return (d and tonumber(d.rank)) or 0
end

local function getUserTag(name)
    -- Prefer live bridge custom tag, then GitHub, then rank default
    local bridge = ActiveSKAUsers[name] or findUserEntry(ActiveSKAUsers, name)
    if bridge and bridge.tag and bridge.tag ~= "" then
        return bridge.tag
    end
    local d = findUserEntry(ServerData.Users, name)
    if d and d.tag then return d.tag end
    local r = getUserRank(name)
    return (RANK_INFO[r] and RANK_INFO[r].Tag) or "SKA USER (free)"
end

-- Merge GitHub JSON + live bridge so bridge presence never wipes logo/anims/effects
local function getMergedUserData(name)
    local merged = {}
    local json = findUserEntry(ServerData.Users, name)
    if type(json) == "table" then
        for k, v in pairs(json) do
            merged[k] = v
        end
    end
    local bridge = ActiveSKAUsers[name] or findUserEntry(ActiveSKAUsers, name)
    if type(bridge) == "table" then
        for k, v in pairs(bridge) do
            -- Only overwrite with non-empty bridge values
            if v ~= nil and v ~= "" then
                merged[k] = v
            end
        end
    end
    return merged
end

-- ============================================================
-- NETWORK — GITHUB JSON FETCH
-- ============================================================
local function httpGetRaw(url)
    -- Always cache-bust so updated GitHub RAW is never served from CDN / executor cache
    local connector = string.find(url, "%?") and "&" or "?"
    url = url .. connector .. "t=" .. tostring(tick()) .. "&_=" .. tostring(os.time())

    -- Prefer game:HttpGet, fall back to executor request APIs
    local ok, raw = pcall(function()
        return game:HttpGet(url, true)
    end)
    if ok and raw and raw ~= "" and not tostring(raw):find("<!DOCTYPE") and not tostring(raw):find("<html") then
        return raw
    end
    if raw_http_request then
        local ok2, res = pcall(function()
            return raw_http_request({
                Url = url,
                Method = "GET",
                Headers = {
                    ["Cache-Control"] = "no-cache, no-store, must-revalidate",
                    ["Pragma"] = "no-cache",
                    ["Expires"] = "0",
                }
            })
        end)
        if ok2 and res then
            local body = res.Body or res.body
            if body and body ~= "" then return body end
        end
    elseif http_request then
        local ok2, res = pcall(function()
            return http_request({ Url = url, Method = "GET" })
        end)
        if ok2 and res then
            local body = res.Body or res.body
            if body and body ~= "" then return body end
        end
    end
    return nil
end

local function fetchGitHub()
    pcall(function()
        local raw = httpGetRaw(CONFIG.GitHubURL)
        if not raw or raw == "" then
            log("fetchGitHub FAILED — empty response / HttpGet blocked")
            return
        end
        local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok or type(data) ~= "table" then
            log("fetchGitHub FAILED — JSON decode error")
            return
        end

        ServerData.Users    = data.users    or {}
        ServerData.Banned   = data.banned   or {}
        if data.globalSettings then
            ServerData.GlobalSettings = data.globalSettings
        end

        -- Ban check — ALWAYS re-evaluate (fixes sticky ban after unban)
        local banEntry = findUserEntry(ServerData.Banned, localPlayer.Name)
        if banEntry then
            LocalUser.IsBanned  = true
            LocalUser.BanReason = banEntry.reason or "No reason given"
            LocalUser.BannedBy  = banEntry.bannedBy or "an admin"
            -- Kick immediately with JSON reason
            local msg = string.format(
                "Banned from SKA by %s\nReason: %s",
                tostring(LocalUser.BannedBy),
                tostring(LocalUser.BanReason)
            )
            task.defer(function()
                pcall(function() localPlayer:Kick(msg) end)
            end)
            log("BANNED — kicking: "..msg)
            return
        else
            -- Explicitly clear ban if they were previously banned this session
            LocalUser.IsBanned  = false
            LocalUser.BanReason = nil
            LocalUser.BannedBy  = nil
        end

        -- Load own data (case-insensitive username match)
        local me = findUserEntry(ServerData.Users, localPlayer.Name)
        if me then
            LocalUser.Rank    = tonumber(me.rank) or 0
            LocalUser.CanEditNametag = me.canEditNametag == true or (LocalUser.Rank >= 1)
            -- Session override (owner funny tag) keeps styles until rejoin
            if not SessionTagOverride then
                LocalUser.Tag = me.tag or (RANK_INFO[LocalUser.Rank] and RANK_INFO[LocalUser.Rank].Tag) or "SKA USER (free)"
                if me.tagColor        then LocalUser.TagColor         = strToColor(me.tagColor)        end
                if me.glowColor       then LocalUser.GlowColor        = strToColor(me.glowColor)       end
                if me.outlineColor    then LocalUser.OutlineColor     = strToColor(me.outlineColor)    end
                if me.backgroundColor then LocalUser.BackgroundColor  = strToColor(me.backgroundColor) end
                if me.font            then LocalUser.Font             = me.font                        end
                if me.logo            then LocalUser.Logo             = me.logo                        end
                if me.animation       then LocalUser.Animation        = me.animation                   end
                if me.bgAnimation     then LocalUser.BgAnimation      = me.bgAnimation                 end
                if me.customUsername  then LocalUser.CustomUsername   = me.customUsername              end
                if me.usernameColor   then LocalUser.UsernameColor    = strToColor(me.usernameColor)   end
                if me.usernameFont    then LocalUser.UsernameFont     = me.usernameFont                end
                if me.effect1         then LocalUser.Effect1          = me.effect1                     end
                if me.effect2         then LocalUser.Effect2          = me.effect2                     end
                if me.effect1Color    then LocalUser.Effect1Color     = strToColor(me.effect1Color)    end
                if me.effect2Color    then LocalUser.Effect2Color     = strToColor(me.effect2Color)    end
                if me.bgImage         then LocalUser.BgImage          = me.bgImage                     end
            end
        else
            -- Not in JSON → free user
            LocalUser.Rank           = 0
            LocalUser.Tag            = RANK_INFO[0].Tag
            LocalUser.CanEditNametag = false
            LocalUser.TagColor       = RANK_INFO[0].Color
        end

        -- Clamp rank to known range
        if not RANK_INFO[LocalUser.Rank] then
            LocalUser.Rank = 0
        end

        -- Set allowed commands
        local rankKey = LocalUser.Rank == 3 and "ownerCommands"
                     or LocalUser.Rank == 2 and "adminCommands"
                     or LocalUser.Rank == 1 and "paidUserCommands"
                     or "freeUserCommands"
        LocalUser.AllowedCommands = ServerData.GlobalSettings[rankKey] or {}

        log("Loaded. Name="..localPlayer.Name.." Rank="..LocalUser.Rank.." Tag="..tostring(LocalUser.Tag))
    end)
end

