-- Execute command received from bridge (MUST be defined before pollForCommands)
local function executeReceivedCommand(cmd)
    local commandType = cmd.command
    local issuer      = cmd.issuer or "?"

    log("Received command: "..commandType.." from "..issuer)

    local char = localPlayer.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")

    if commandType == "kill" then
        if hum then
            hum.Health = 0
            notify("⚔ Admin Action", issuer.." killed you", 3)
        end

    elseif commandType == "kick" or commandType == "crash" then
        localPlayer:Kick("[SKA Admin] Removed by "..issuer)

    elseif commandType == "blind" then
        local pg = PlayerGui
        local sg = Instance.new("ScreenGui")
        sg.Name = "SKA_Blind"  sg.ResetOnSpawn = false  sg.DisplayOrder = 9999
        local fr = Instance.new("Frame", sg)
        fr.Size = UDim2.new(1,0,1,0)  fr.BackgroundColor3 = Color3.new(0,0,0)
        sg.Parent = pg
        game:GetService("Debris"):AddItem(sg, 10)
        notify("👁 Admin Action", issuer.." blinded you for 10s", 3)

    elseif commandType == "bring" then
        local issuerPlr = Players:FindFirstChild(issuer)
        if issuerPlr and issuerPlr.Character and issuerPlr.Character:FindFirstChild("HumanoidRootPart") and hrp then
            hrp.CFrame = issuerPlr.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -3)
            notify("🔗 Admin Action", issuer.." brought you", 2)
        else
            notify("🔗 Admin Action", issuer.." requested bring", 2)
        end

    elseif commandType == "fling" then
        if hrp then
            local bv = Instance.new("BodyVelocity")
            bv.Velocity = Vector3.new(math.random(-1200,1200), 1200, math.random(-1200,1200))
            bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
            bv.Parent   = hrp
            game:GetService("Debris"):AddItem(bv, 0.3)
            notify("🚀 Admin Action", issuer.." flung you", 2)
        end

    elseif commandType == "freeze" then
        if hum then
            hum.WalkSpeed = 0  hum.JumpPower = 0
            notify("❄ Admin Action", issuer.." froze you", 3)
        end

    elseif commandType == "unfreeze" then
        if hum then
            hum.WalkSpeed = 16  hum.JumpPower = 50
            notify("🔓 Admin Action", issuer.." unfroze you", 2)
        end

    elseif commandType == "respawn" then
        localPlayer:LoadCharacter()
        notify("♻ Admin Action", issuer.." respawned you", 2)
    end
end

-- Send command through bridge (bridge validates rank + jobId match)
local function sendCommandToBridge(targetName, commandType)
    if not http_request then
        notify("Bridge Error","HTTP requests not available in this executor",3)
        return
    end
    pcall(function()
        local res = http_request({
            Url     = CONFIG.LocalHostURL.."/command",
            Method  = "POST",
            Headers = {["Content-Type"]="application/json"},
            Body    = HttpService:JSONEncode({
                issuer     = localPlayer.Name,
                issuerRank = LocalUser.Rank,
                target     = targetName,
                command    = commandType,
                jobId      = game.JobId,
            })
        })
        if res and res.StatusCode == 200 then
            local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if ok then notify("✅ Command Sent", data.message or "Queued", 2) end
        else
            local errMsg = "Failed"
            if res and res.Body then
                local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                if ok and data and data.message then errMsg = data.message end
            end
            notify("❌ Command Error", errMsg, 3)
        end
    end)
end

-- Poll for commands directed at this player
local function pollForCommands()
    if not http_request then return end
    pcall(function()
        local res = http_request({
            Url    = CONFIG.LocalHostURL.."/commands/"..game.JobId.."?username="..localPlayer.Name,
            Method = "GET"
        })
        if res and res.StatusCode == 200 and res.Body then
            local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if ok and data.commands and #data.commands > 0 then
                for _, cmd in ipairs(data.commands) do
                    pcall(function() executeReceivedCommand(cmd) end)
                end
            end
        end
    end)
end

-- Background command polling (every 2s, automatic)
