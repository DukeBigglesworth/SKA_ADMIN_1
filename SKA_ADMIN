-- Local fling: TP to target, weld/high velocity, return home
local function flingPlayerLocal(target)
    if not target or not target.Character then
        notify("Fling", "Invalid target.", 2)
        return
    end
    local myChar = localPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local tgHRP = target.Character:FindFirstChild("HumanoidRootPart")
    if not myHRP or not tgHRP then
        notify("Fling", "Missing HumanoidRootPart.", 2)
        return
    end
    local startCF = myHRP.CFrame
    local startPos = myHRP.Position

    -- Move onto target
    myHRP.CFrame = tgHRP.CFrame
    local weld = Instance.new("WeldConstraint")
    weld.Part0 = myHRP
    weld.Part1 = tgHRP
    weld.Parent = myHRP

    local bv = Instance.new("BodyVelocity")
    bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
    bv.Velocity = Vector3.new(0, 1e5, 0) + tgHRP.CFrame.LookVector * 1e4
    bv.Parent = myHRP

    local bang = Instance.new("BodyAngularVelocity")
    bang.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
    bang.AngularVelocity = Vector3.new(0, 9e4, 0)
    bang.Parent = myHRP

    notify("Fling", "Flinging " .. target.Name .. "...", 2)
    task.wait(0.45)
    pcall(function() weld:Destroy() end)
    pcall(function() bv:Destroy() end)
    pcall(function() bang:Destroy() end)
    task.wait(0.05)
    myHRP.AssemblyLinearVelocity = Vector3.zero
    myHRP.AssemblyAngularVelocity = Vector3.zero
    myHRP.CFrame = startCF
    myHRP.AssemblyLinearVelocity = Vector3.zero
    notify("Fling", "Returned.", 1.5)
end

local function spinSelf(duration)
    duration = duration or 3
    local char = localPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        notify("Spin", "No character", 2)
        return
    end
    -- Prefer modern AngularVelocity if available, else BodyAngularVelocity, else CFrame spin
    local stopped = false
    local mover = nil
    pcall(function()
        mover = Instance.new("BodyAngularVelocity")
        mover.Name = "SKA_Spin"
        mover.MaxTorque = Vector3.new(0, math.huge, 0)
        mover.AngularVelocity = Vector3.new(0, 40, 0)
        mover.P = 1250
        mover.Parent = hrp
    end)
    if not mover or not mover.Parent then
        -- Heartbeat CFrame spin fallback
        local conn
        local t0 = tick()
        conn = RunService.Heartbeat:Connect(function(dt)
            if stopped or tick() - t0 > duration then
                if conn then conn:Disconnect() end
                return
            end
            if hrp and hrp.Parent then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad(720 * dt), 0)
            end
        end)
        task.delay(duration, function()
            stopped = true
            if conn then conn:Disconnect() end
        end)
    else
        task.delay(duration, function()
            stopped = true
            pcall(function() mover:Destroy() end)
        end)
    end
    notify("Fun", "Spinning!", 2)
end

