    if not UI.ScreenGui then return end
    local existing = UI.ScreenGui:FindFirstChild("SKA_TargetModal")
    if existing then existing:Destroy() end

    local modal = Instance.new("Frame", UI.ScreenGui)
    modal.Name = "SKA_TargetModal"
    modal.Size = UDim2.new(1,0,1,0)
    modal.BackgroundColor3 = Color3.new(0,0,0)
    modal.BackgroundTransparency = 0.45
    modal.BorderSizePixel = 0
    modal.ZIndex = 400

    local card = Instance.new("Frame", modal)
    card.Size = UDim2.new(0, 300, 0, 360)
    card.Position = UDim2.new(0.5, -150, 0.5, -180)
    card.BackgroundColor3 = Theme.Background
    card.BorderSizePixel = 0
    card.ZIndex = 401
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 14)
    local cStroke = Instance.new("UIStroke", card)
    cStroke.Color = Theme.Accent cStroke.Thickness = 2

    local header = Instance.new("Frame", card)
    header.Size = UDim2.new(1,0,0,44)
    header.BackgroundColor3 = Theme.BackgroundSecondary
    header.BorderSizePixel = 0
    header.ZIndex = 402
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 14)
    local hFix = Instance.new("Frame", header)
    hFix.Size = UDim2.new(1,0,0,12) hFix.Position = UDim2.new(0,0,1,-12)
    hFix.BackgroundColor3 = Theme.BackgroundSecondary hFix.BorderSizePixel = 0 hFix.ZIndex = 402

    local title = Instance.new("TextLabel", header)
    title.Size = UDim2.new(1,-50,1,0) title.Position = UDim2.new(0,14,0,0)
    title.BackgroundTransparency = 1
    title.Text = "SELECT TARGET  ·  " .. tostring(cmdName)
    title.TextColor3 = Theme.Accent title.Font = Enum.Font.GothamBold
    title.TextSize = 13 title.TextXAlignment = Enum.TextXAlignment.Left title.ZIndex = 403

    local closeBtn = Instance.new("TextButton", header)
    closeBtn.Size = UDim2.new(0,28,0,28) closeBtn.Position = UDim2.new(1,-36,0,8)
    closeBtn.BackgroundColor3 = Color3.fromRGB(200,50,60)
    closeBtn.Text = "×" closeBtn.TextColor3 = Color3.new(1,1,1)
    closeBtn.Font = Enum.Font.GothamBold closeBtn.TextSize = 16 closeBtn.ZIndex = 403
    Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(0,7)
    closeBtn.MouseButton1Click:Connect(function() modal:Destroy() end)

    local sub = Instance.new("TextLabel", card)
    sub.Size = UDim2.new(1,-20,0,18) sub.Position = UDim2.new(0,10,0,48)
    sub.BackgroundTransparency = 1
    sub.Text = "SKA users in this server only"
    sub.TextColor3 = Theme.TextDim sub.Font = Enum.Font.Gotham sub.TextSize = 10
    sub.TextXAlignment = Enum.TextXAlignment.Left sub.ZIndex = 402

    local scroll = Instance.new("ScrollingFrame", card)
    scroll.Size = UDim2.new(1,-20,1,-80) scroll.Position = UDim2.new(0,10,0,70)
    scroll.BackgroundTransparency = 1 scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 3 scroll.CanvasSize = UDim2.new(0,0,0,0)
    scroll.ZIndex = 402
    local layout = Instance.new("UIListLayout", scroll)
    layout.Padding = UDim.new(0,5)

    local count = 0
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == localPlayer then continue end
        -- Only SKA users (in ActiveSKAUsers same job, or listed in GitHub JSON)
        local bridge = ActiveSKAUsers[plr.Name] or findUserEntry(ActiveSKAUsers, plr.Name)
        local inJson = findUserEntry(ServerData.Users, plr.Name)
        local isSKA = (bridge and bridge.jobId == game.JobId) or (inJson ~= nil)
        if not isSKA then continue end
        if not canTarget(plr.Name) then continue end

        count = count + 1
        local b = Instance.new("TextButton", scroll)
        b.Size = UDim2.new(1,0,0,40)
        b.BackgroundColor3 = Theme.BackgroundSecondary
        b.Text = "" b.AutoButtonColor = false b.ZIndex = 403
        Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)

        local nl = Instance.new("TextLabel", b)
        nl.Size = UDim2.new(0.6,0,1,0) nl.Position = UDim2.new(0,12,0,0)
        nl.BackgroundTransparency = 1 nl.Text = plr.Name
        nl.TextColor3 = Theme.Text nl.Font = Enum.Font.GothamBold
        nl.TextSize = 13 nl.TextXAlignment = Enum.TextXAlignment.Left nl.ZIndex = 404

        local rk = getUserRank(plr.Name)
        local rl = Instance.new("TextLabel", b)
        rl.Size = UDim2.new(0.4,-10,1,0) rl.Position = UDim2.new(0.6,0,0,0)
        rl.BackgroundTransparency = 1
        rl.Text = RANK_INFO[rk] and RANK_INFO[rk].Tag or "SKA"
        rl.TextColor3 = RANK_INFO[rk] and RANK_INFO[rk].Color or Theme.TextDim
        rl.Font = Enum.Font.Code rl.TextSize = 10
        rl.TextXAlignment = Enum.TextXAlignment.Right rl.ZIndex = 404

        b.MouseEnter:Connect(function() tween(b,{BackgroundColor3=Theme.Accent},0.12) end)
        b.MouseLeave:Connect(function() tween(b,{BackgroundColor3=Theme.BackgroundSecondary},0.12) end)
        b.MouseButton1Click:Connect(function()
            executeCommand(plr, cmd, extra)
            modal:Destroy()
        end)
    end

    if count == 0 then
        local none = Instance.new("TextLabel", scroll)
        none.Size = UDim2.new(1,0,0,50) none.BackgroundTransparency = 1
        none.Text = "No other SKA users in this server\n(or none you can target)"
        none.TextColor3 = Theme.TextDim none.Font = Enum.Font.Gotham
        none.TextSize = 11 none.TextWrapped = true none.ZIndex = 403
    end
    scroll.CanvasSize = UDim2.new(0,0,0, count * 45 + 10)
    makeDraggable(card)
end

