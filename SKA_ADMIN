-- Role detection (original logic)
local function getRole(plr)
    if not plr.Character then return "None" end
    local function hasTool(keyword)
        keyword = keyword:lower()
        for _, o in ipairs(plr.Character:GetChildren()) do
            if o:IsA("Tool") and o.Name:lower():find(keyword) then return true end
        end
        local bp = plr:FindFirstChild("Backpack")
        if bp then
            for _, o in ipairs(bp:GetChildren()) do
                if o:IsA("Tool") and o.Name:lower():find(keyword) then return true end
            end
        end
        return false
    end
    if hasTool("knife") or hasTool("blade") then return "Murderer" end
    if hasTool("gun")   or hasTool("revolver") then return "Sheriff" end
    if plr.Team and plr.Team.Name:lower():find("dead") then return "Dead" end
    return "Alive"
end

-- Bring All (heartbeat, original approach)
local function bringAll()
    if not State.BringActive then return end
    local char = localPlayer.Character
    if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp  then return end
    local cf   = hrp.CFrame + hrp.CFrame.LookVector * CONFIG.BringOffset
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character and not pardoned[plr.Name] then
            local t = plr.Character:FindFirstChild("HumanoidRootPart")
            if t then
                t.CFrame = cf * CFrame.new(math.random(-2,2), 0, math.random(-2,2))
                local h = plr.Character:FindFirstChild("Humanoid")
                if h then h.WalkSpeed = 0  h.JumpPower = 0 end
            end
        end
    end
end

-- Bring Murderer Only (original logic)
local function bringMurdererOnly()
    local char = localPlayer.Character
    if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp  then return end
    local cf   = hrp.CFrame + hrp.CFrame.LookVector * CONFIG.BringOffset
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character and getRole(plr) == "Murderer" then
            local t = plr.Character:FindFirstChild("HumanoidRootPart")
            if t then
                t.CFrame = cf
                local h  = plr.Character:FindFirstChild("Humanoid")
                if h then h.WalkSpeed = 0  h.JumpPower = 0 end
                notify("Combat", "Brought murderer: "..plr.Name, 2)
                return
            end
        end
    end
    notify("Combat", "No murderer found in game", 2)
end

-- ESP update loop (original logic)
local function updateESP()
    if not State.ESPEnabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character
        and plr.Character:FindFirstChild("HumanoidRootPart") then
            local role = getRole(plr)
            local col  = role == "Murderer" and Theme.Murderer
                      or role == "Sheriff"  and Theme.Sheriff
                      or role == "Alive"    and Theme.Alive
                      or nil
            if col then
                local hl = Highlights[plr]
                if not hl or not hl.Parent then
                    hl = Instance.new("Highlight")
                    hl.FillTransparency    = 1
                    hl.OutlineTransparency = 0
                    hl.DepthMode           = Enum.HighlightDepthMode.AlwaysOnTop
                    hl.Parent              = plr.Character
                    Highlights[plr]        = hl
                end
                hl.OutlineColor = col
            else
                if Highlights[plr] then
                    Highlights[plr]:Destroy()
                    Highlights[plr] = nil
                end
            end
        end
    end
end

-- ============================================================
-- ADMIN COMMANDS (rank-gated, original + expanded)
-- ============================================================
local function executeCommand(target, cmd)
    if not target or not target.Character then
        notify("Admin","Target has no character",2)
        return
    end

    -- All commands flow through the bridge: bridge validates rank + same jobId,
    -- then queues for the target's pollForCommands to execute on their client.
    sendCommandToBridge(target.Name, cmd)

    -- "bring" is the ONLY command that also runs locally on the issuer's side,
    -- because the issuer is the one moving the target's HumanoidRootPart.
    if cmd == "bring" then
        local myChar = localPlayer.Character
        local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local hrp    = target.Character:FindFirstChild("HumanoidRootPart")
        local hum    = target.Character:FindFirstChild("Humanoid")
        if myHRP and hrp then
            hrp.CFrame = myHRP.CFrame + myHRP.CFrame.LookVector * 4
            if hum then hum.WalkSpeed=0  hum.JumpPower=0 end
            notify("🔗 Admin","Brought "..target.Name, 2)
        end
    end
end

