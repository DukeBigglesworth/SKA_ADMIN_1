    {Name="BLIND",       Desc="Black screen 5s",           Cmd="blind",       Icon="👁",  MinRank=1, Color=Color3.fromRGB(150,50,255)},
    {Name="KILL",        Desc="Instant death",             Cmd="kill",        Icon="💀", MinRank=2, Color=Color3.fromRGB(220,40,60)},
