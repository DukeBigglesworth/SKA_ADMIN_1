local function normalizeAsset(id)
	if not id or id == "" or id == "default" then return nil end
	id = tostring(id)
	if id:match("^%d+$") then return "rbxassetid://"..id end
	if id:match("^rbxassetid://") or id:match("^http") then return id end
	return id
end

