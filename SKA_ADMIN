-- Role detection (original logic)
local function getRole(plr)
    if not plr.Character then return "None" end
    local function hasTool(keyword)
        keyword = keyword:lower()
        for _, o in ipairs(plr.Character:GetChildren()) do
            if o:IsA("Tool") and o.Name:lower():find(keyword) then return true end
        end
        local bp = plr:FindFirstChild("Backpack")
        if bp then
            for _, o in ipairs(bp:GetChildren()) do
                if o:IsA("Tool") and o.Name:lower():find(keyword) then return true end
            end
        end
        return false
    end
    if hasTool("knife") or hasTool("blade") then return "Murderer" end
    if hasTool("gun")   or hasTool("revolver") then return "Sheriff" end
    if plr.Team and plr.Team.Name:lower():find("dead") then return "Dead" end
    return "Alive"
end

-- Bring All (heartbeat, original approach)
local function bringAll()
    if not State.BringActive then return end
    local char = localPlayer.Character
    if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp  then return end
    local cf   = hrp.CFrame + hrp.CFrame.LookVector * CONFIG.BringOffset
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character and not pardoned[plr.Name] then
            local t = plr.Character:FindFirstChild("HumanoidRootPart")
            if t then
                t.CFrame = cf * CFrame.new(math.random(-2,2), 0, math.random(-2,2))
                local h = plr.Character:FindFirstChild("Humanoid")
                if h then h.WalkSpeed = 0  h.JumpPower = 0 end
            end
        end
    end
end

-- Bring Murderer Only (original logic)
local function bringMurdererOnly()
    local char = localPlayer.Character
    if not char then return end
    local hrp  = char:FindFirstChild("HumanoidRootPart")
    if not hrp  then return end
    local cf   = hrp.CFrame + hrp.CFrame.LookVector * CONFIG.BringOffset
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= localPlayer and plr.Character and getRole(plr) == "Murderer" then
            local t = plr.Character:FindFirstChild("HumanoidRootPart")
            if t then
                t.CFrame = cf
                local h  = plr.Character:FindFirstChild("Humanoid")
                if h then h.WalkSpeed = 0  h.JumpPower = 0 end
                notify("Combat", "Brought murderer: "..plr.Name, 2)
                return
            end
        end
    end
    notify("Combat", "No murderer found in game", 2)
end

-- ESP update loop (original logic)
local function clearHighlight(plr)
    local hl = Highlights[plr]
    if hl then
        pcall(function() hl:Destroy() end)
        Highlights[plr] = nil
    end
end

local function applyESPToPlayer(plr)
    if not State.ESPEnabled or plr == localPlayer then return end
    local char = plr.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then
        clearHighlight(plr)
        return
    end

    local role = getRole(plr)
    local col  = role == "Murderer" and Theme.Murderer
              or role == "Sheriff"  and Theme.Sheriff
              or role == "Alive"    and Theme.Alive
              or nil

    if not col then
        clearHighlight(plr)
        return
    end

    local hl = Highlights[plr]
    -- Recreate if missing, destroyed, or parented to an old (dead) character
    if not hl or not hl.Parent or hl.Parent ~= char then
        clearHighlight(plr)
        hl = Instance.new("Highlight")
        hl.Name                 = "SKA_ESP"
        hl.FillTransparency     = 1
        hl.OutlineTransparency  = 0
        hl.DepthMode            = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Adornee              = char
        hl.Parent               = char
        Highlights[plr]         = hl
    end
    hl.OutlineColor = col
end

local function updateESP()
    if not State.ESPEnabled then return end
    for _, plr in ipairs(Players:GetPlayers()) do
        applyESPToPlayer(plr)
    end
end

-- Hook character lifecycle so ESP returns immediately after death/respawn
local function setupESPHooks(plr)
    if plr == localPlayer then return end
    plr.CharacterAdded:Connect(function(char)
        if not State.ESPEnabled then return end
        -- Wait for HumanoidRootPart (and tools for role detection)
        task.spawn(function()
            local hrp = char:WaitForChild("HumanoidRootPart", 8)
            if not hrp or not State.ESPEnabled then return end
            task.wait(0.35) -- tools / team can lag a frame
            applyESPToPlayer(plr)
        end)
    end)
    plr.CharacterRemoving:Connect(function()
        clearHighlight(plr)
    end)
end

for _, plr in ipairs(Players:GetPlayers()) do
    setupESPHooks(plr)
end
Players.PlayerAdded:Connect(setupESPHooks)

