local function buildAdminPanel()
    local panel = UI.Panels.Admin

    -- Rank display card
    local rankCard=Instance.new("Frame",panel)
    rankCard.Size=UDim2.new(1,-10,0,64) rankCard.Position=UDim2.new(0,5,0,5)
    rankCard.BackgroundColor3=Theme.BackgroundSecondary rankCard.BorderSizePixel=0
    Instance.new("UICorner",rankCard).CornerRadius=UDim.new(0,10)
    local rankStroke=Instance.new("UIStroke",rankCard)
    rankStroke.Color=Theme.Accent rankStroke.Thickness=1.5

    local rl=Instance.new("TextLabel",rankCard)
    rl.Size=UDim2.new(1,-10,0,20) rl.Position=UDim2.new(0,10,0,6)
    rl.BackgroundTransparency=1 rl.Text="YOUR RANK"
    rl.TextColor3=Theme.TextDim rl.Font=Enum.Font.GothamBold rl.TextSize=10
    rl.TextXAlignment=Enum.TextXAlignment.Left rl.TextScaled=false

    local rankDisp=Instance.new("TextLabel",rankCard)
    rankDisp.Size=UDim2.new(1,-10,0,30) rankDisp.Position=UDim2.new(0,10,0,28)
    rankDisp.BackgroundTransparency=1 rankDisp.Text=RANK_INFO[LocalUser.Rank].Tag
    rankDisp.TextColor3=RANK_INFO[LocalUser.Rank].Color rankDisp.Font=Enum.Font.Code
    rankDisp.TextSize=16 rankDisp.TextXAlignment=Enum.TextXAlignment.Left rankDisp.TextScaled=false

    task.spawn(function()
        while task.wait(1) do
            if rankDisp and rankDisp.Parent then
                rankDisp.Text       = RANK_INFO[LocalUser.Rank].Tag
                rankDisp.TextColor3 = RANK_INFO[LocalUser.Rank].Color
                rankStroke.Color    = RANK_INFO[LocalUser.Rank].Color
            end
        end
    end)

    -- Command rows — built from ADMIN_CMDS, lock state evaluated LIVE on click
    local lockRefreshFns = {}  -- called when rank updates after JSON reload

    local function makeSectionLbl(txt, yPos)
        local l=Instance.new("TextLabel",panel)
        l.Size=UDim2.new(1,-10,0,16) l.Position=UDim2.new(0,5,0,yPos)
        l.BackgroundTransparency=1 l.Text=txt
        l.TextColor3=Theme.TextDim l.Font=Enum.Font.GothamBold
        l.TextSize=10 l.TextScaled=false
        l.TextXAlignment=Enum.TextXAlignment.Left
    end

    local y = 80
    makeSectionLbl("▸  PREMIUM  (rank 1+)", 76)
    y = y + 20

    local prevMinRank = nil
    for _,cmd in ipairs(ADMIN_CMDS) do
        -- Section divider between tiers
        if cmd.MinRank ~= prevMinRank and prevMinRank ~= nil then
            y = y + 4
            local tierLabel = cmd.MinRank == 2 and "▸  ADMIN  (rank 2+)"
                           or cmd.MinRank == 3 and "▸  OWNER  (rank 3)"
                           or nil
            if tierLabel then makeSectionLbl(tierLabel, y) y = y + 20 end
        end
        prevMinRank = cmd.MinRank

        local btn=Instance.new("TextButton",panel)
        btn.Size=UDim2.new(1,-10,0,50) btn.Position=UDim2.new(0,5,0,y)
        btn.BackgroundColor3=Theme.BackgroundSecondary btn.Text=""
        btn.AutoButtonColor=false
        Instance.new("UICorner",btn).CornerRadius=UDim.new(0,9)

        local iconL=Instance.new("TextLabel",btn)
        iconL.Size=UDim2.new(0,32,1,0) iconL.Position=UDim2.new(0,8,0,0)
        iconL.BackgroundTransparency=1 iconL.Text=cmd.Icon iconL.TextSize=20 iconL.TextScaled=false

        local nameL=Instance.new("TextLabel",btn)
        nameL.Name="NameL"
        nameL.Size=UDim2.new(0.5,0,0,20) nameL.Position=UDim2.new(0,46,0,7)
        nameL.BackgroundTransparency=1 nameL.Text=cmd.Name
        nameL.Font=Enum.Font.GothamBold nameL.TextSize=13 nameL.TextScaled=false
        nameL.TextXAlignment=Enum.TextXAlignment.Left

        local descL=Instance.new("TextLabel",btn)
        descL.Size=UDim2.new(0.55,0,0,14) descL.Position=UDim2.new(0,46,0,28)
        descL.BackgroundTransparency=1 descL.Text=cmd.Desc
        descL.TextColor3=Theme.TextDim descL.Font=Enum.Font.Gotham descL.TextSize=10 descL.TextScaled=false
        descL.TextXAlignment=Enum.TextXAlignment.Left

        local statusL=Instance.new("TextLabel",btn)
        statusL.Name="StatusL"
        statusL.Size=UDim2.new(0.32,0,1,0) statusL.Position=UDim2.new(0.68,-5,0,0)
        statusL.BackgroundTransparency=1
        statusL.Font=Enum.Font.GothamBold statusL.TextSize=10 statusL.TextScaled=false
        statusL.TextXAlignment=Enum.TextXAlignment.Right

        -- Live-refresh lock appearance
        local function refreshLock()
            local locked = LocalUser.Rank < cmd.MinRank
            nameL.TextColor3   = locked and Theme.Dead or cmd.Color
            statusL.Text       = locked and "🔒 LOCKED" or "EXECUTE"
            statusL.TextColor3 = locked and Theme.Dead or Theme.Accent
        end
        refreshLock()
        table.insert(lockRefreshFns, refreshLock)

        btn.MouseEnter:Connect(function() tween(btn,{BackgroundColor3=Theme.BackgroundTertiary},0.15) end)
        btn.MouseLeave:Connect(function() tween(btn,{BackgroundColor3=Theme.BackgroundSecondary},0.15) end)

        -- LIVE rank check on every click — not at build time
        btn.MouseButton1Click:Connect(function()
            if LocalUser.Rank < cmd.MinRank then
                notify("Access Denied","Requires "..RANK_INFO[cmd.MinRank].Name.." rank.",3) return
            end
            if cmd.Cmd == "givenametag" then
                showGiveNametagUI()
            else
                showTargetSelector(cmd.Cmd, cmd.Name)
            end
        end)
        y = y + 56
    end

    -- Refresh lock visuals whenever JSON reloads and rank changes
    task.spawn(function()
        local lastRank = LocalUser.Rank
        while task.wait(2) do
            if LocalUser.Rank ~= lastRank then
                lastRank = LocalUser.Rank
                for _,fn in ipairs(lockRefreshFns) do pcall(fn) end
            end
        end
    end)

    -- Target selector frame (embedded at bottom)
    UI.TargetFrame=Instance.new("Frame",panel)
    UI.TargetFrame.Size=UDim2.new(1,-10,0,200)
    UI.TargetFrame.Position=UDim2.new(0,5,0,y)
    UI.TargetFrame.BackgroundColor3=Theme.BackgroundSecondary UI.TargetFrame.BorderSizePixel=0
