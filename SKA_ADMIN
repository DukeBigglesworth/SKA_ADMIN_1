function showTargetSelector(cmd, cmdName)
    if not UI.TargetFrame then return end
    local tTitle=UI.TargetFrame:FindFirstChild("TargetTitle")
    if tTitle then tTitle.Text="SELECT TARGET  —  "..cmdName end
    UI.TargetFrame.Visible=true

    for _,c in ipairs(UI.TargetScroll:GetChildren()) do
        if c:IsA("TextButton") or c:IsA("Frame") then c:Destroy() end
    end

    local count=0
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=localPlayer and canTarget(plr.Name) then
            count=count+1
            local b=Instance.new("TextButton",UI.TargetScroll)
            b.Size=UDim2.new(1,0,0,34)
            b.BackgroundColor3=Theme.BackgroundTertiary b.Text="" b.AutoButtonColor=false
            Instance.new("UICorner",b).CornerRadius=UDim.new(0,7)

            local nl=Instance.new("TextLabel",b)
            nl.Size=UDim2.new(0.65,0,1,0) nl.Position=UDim2.new(0,10,0,0)
            nl.BackgroundTransparency=1 nl.Text=plr.Name
            nl.TextColor3=Theme.Text nl.Font=Enum.Font.GothamBold
            nl.TextSize=12 nl.TextScaled=false nl.TextXAlignment=Enum.TextXAlignment.Left

            local rk=getUserRank(plr.Name)
            local rl=Instance.new("TextLabel",b)
            rl.Size=UDim2.new(0.35,0,1,0) rl.Position=UDim2.new(0.65,-5,0,0)
            rl.BackgroundTransparency=1 rl.Text="["..RANK_INFO[rk].Name.."]"
            rl.TextColor3=RANK_INFO[rk].Color
            rl.Font=Enum.Font.Code rl.TextSize=10 rl.TextScaled=false
            rl.TextXAlignment=Enum.TextXAlignment.Right

            b.MouseEnter:Connect(function() tween(b,{BackgroundColor3=Theme.Accent},0.15) end)
            b.MouseLeave:Connect(function() tween(b,{BackgroundColor3=Theme.BackgroundTertiary},0.15) end)
            b.MouseButton1Click:Connect(function()
                executeCommand(plr, cmd)
                UI.TargetFrame.Visible=false
            end)
        end
    end
    if count==0 then
        local none=Instance.new("TextLabel",UI.TargetScroll)
        none.Size=UDim2.new(1,0,0,34) none.BackgroundTransparency=1
        none.Text="No valid targets" none.TextColor3=Theme.TextDim
        none.Font=Enum.Font.Gotham none.TextSize=11 none.TextScaled=false
    end
    UI.TargetScroll.CanvasSize=UDim2.new(0,0,0,count*38+10)
end

