local function tpMap()
    local map = getMap()
    if not map then notify("MM2", "No map.", 2) return end
    local spawns = map:FindFirstChild("Spawns")
    if not spawns then notify("MM2", "No spawns.", 2) return end
    local kids = spawns:GetChildren()
    if #kids == 0 then return end
    local pick = kids[math.random(1, #kids)]
    pcall(function()
        localPlayer.Character:MoveTo(pick.Position)
    end)
    notify("MM2", "Teleported to map.", 2)
end

-- ============================================================
-- ADMIN COMMANDS (rank-gated, original + expanded)
-- ============================================================
local function executeCommand(target, cmd, extra)
    if not target then
        notify("Admin","No target",2)
        return
    end
    -- ban / forcechat don't need their character present
    local needsChar = (cmd ~= "ban" and cmd ~= "forcechat" and cmd ~= "forceroles"
        and cmd ~= "forcekillaura" and cmd ~= "givenametag")
    if needsChar and not target.Character then
        notify("Admin","Target has no character",2)
        return
    end

    sendCommandToBridge(target.Name, cmd, extra)

    if cmd == "bring" and target.Character then
        local myChar = localPlayer.Character
        local myHRP  = myChar and myChar:FindFirstChild("HumanoidRootPart")
        local hrp    = target.Character:FindFirstChild("HumanoidRootPart")
        local hum    = target.Character:FindFirstChild("Humanoid")
        if myHRP and hrp then
            hrp.CFrame = myHRP.CFrame + myHRP.CFrame.LookVector * 4
            if hum then hum.WalkSpeed=0  hum.JumpPower=0 end
            notify("🔗 Admin","Brought "..target.Name, 2)
        end
    end
end

