    local function consoleOut(msg, col)
        outBg.Visible = true
        outLabel.Text = msg
        outLabel.TextColor3 = col or Theme.Text
        task.delay(4, function() if outBg and outBg.Parent then outBg.Visible=false end end)
    end

    local flyActive = false

    local function runCommand(raw)
        raw = raw:match("^%s*;?(.-)%s*$")  -- strip leading ; and whitespace
        if raw == "" then return end
        local parts = {}
        for w in raw:gmatch("%S+") do table.insert(parts,w) end
        local cmd = parts[1] and parts[1]:lower() or ""
        local arg = parts[2] or ""

        if cmd == "fly" then
            if not flyActive then
                flyActive=true State.FlyActive=true
                enableFly() consoleOut("Fly ON",Theme.Alive) updateStatus()
            end

        elseif cmd == "unfly" or cmd == "nofly" then
            if flyActive then
                flyActive=false State.FlyActive=false
                disableFly() consoleOut("Fly OFF",Theme.Murderer) updateStatus()
            end

        elseif cmd == "esp" then
            local on = arg:lower()~="off"
            State.ESPEnabled = on
            if on then
                task.spawn(function()
                    while State.ESPEnabled do updateESP() task.wait(2) end
                end)
            else
                for _,hl in pairs(Highlights) do if hl then hl:Destroy() end end
                Highlights = {}
            end
            updateStatus()
            consoleOut("ESP "..(on and "ON" or "OFF"))

        elseif cmd == "fullbright" or cmd == "fb" then
            local on = arg:lower()~="off"
            State.Fullbright = on
            Lighting.Ambient    = on and Color3.new(1,1,1) or Color3.fromRGB(70,70,70)
            Lighting.Brightness = on and 2 or 1
            consoleOut("Fullbright "..(on and "ON" or "OFF"))

        elseif cmd == "bring" then
            if arg == "" then
                if LocalUser.Rank < 1 then consoleOut("No permission",Theme.Murderer) return end
                State.BringActive = true
                if Connections.Bring then Connections.Bring:Disconnect() end
                Connections.Bring = RunService.Heartbeat:Connect(bringAll)
                _G.SKA_BRING_CONN = Connections.Bring
                consoleOut("Bring All ON",Theme.Alive)
            else
                local tPlr = Players:FindFirstChild(arg)
                if not tPlr then consoleOut("Player not found: "..arg, Theme.Murderer) return end
                if LocalUser.Rank < 1 then consoleOut("No permission",Theme.Murderer) return end
                executeCommand(tPlr,"bring")
                consoleOut("Brought "..arg)
            end
            updateStatus()

        elseif cmd == "unbring" or cmd == "stopbring" then
            State.BringActive = false
            if Connections.Bring then Connections.Bring:Disconnect() Connections.Bring=nil end
            updateStatus()
            consoleOut("Bring stopped")

        elseif cmd == "kill" then
            if LocalUser.Rank < 2 then consoleOut("Requires Admin rank",Theme.Murderer) return end
            local tPlr = Players:FindFirstChild(arg)
            if not tPlr then consoleOut("Player not found: "..arg, Theme.Murderer) return end
            executeCommand(tPlr,"kill")
            consoleOut("Killed "..arg, Theme.Murderer)

        elseif cmd == "crash" then
            if LocalUser.Rank < 2 then consoleOut("Requires Admin rank",Theme.Murderer) return end
            local tPlr = Players:FindFirstChild(arg)
            if not tPlr then consoleOut("Player not found: "..arg, Theme.Murderer) return end
            executeCommand(tPlr,"crash")
            consoleOut("Crashed "..arg, Theme.Murderer)

        elseif cmd == "respawn" then
            if LocalUser.Rank < 2 then consoleOut("Requires Admin rank",Theme.Murderer) return end
            local tPlr = Players:FindFirstChild(arg)
            if not tPlr then consoleOut("Player not found: "..arg, Theme.Murderer) return end
            executeCommand(tPlr,"respawn")
            consoleOut("Respawned "..arg)

        elseif cmd == "fling" then
            if LocalUser.Rank < 1 then consoleOut("Requires Premium rank",Theme.Murderer) return end
            local tPlr = Players:FindFirstChild(arg)
            if not tPlr then consoleOut("Player not found: "..arg, Theme.Murderer) return end
            executeCommand(tPlr,"fling")
            consoleOut("Flung "..arg)

        elseif cmd == "blind" then
            if LocalUser.Rank < 1 then consoleOut("Requires Premium rank",Theme.Murderer) return end
            local tPlr = Players:FindFirstChild(arg)
            if not tPlr then consoleOut("Player not found: "..arg, Theme.Murderer) return end
            executeCommand(tPlr,"blind")
            consoleOut("Blinded "..arg)

        elseif cmd == "freeze" then
            if LocalUser.Rank < 1 then consoleOut("Requires Premium rank",Theme.Murderer) return end
            local tPlr = Players:FindFirstChild(arg)
            if not tPlr then consoleOut("Player not found: "..arg, Theme.Murderer) return end
            executeCommand(tPlr,"freeze")
            consoleOut("Froze "..arg)

        elseif cmd == "unfreeze" then
            if LocalUser.Rank < 1 then consoleOut("Requires Premium rank",Theme.Murderer) return end
            local tPlr = Players:FindFirstChild(arg)
            if not tPlr then consoleOut("Player not found: "..arg, Theme.Murderer) return end
            executeCommand(tPlr,"unfreeze")
            consoleOut("Unfroze "..arg)

        elseif cmd == "tp" or cmd == "teleport" then
            local tPlr = Players:FindFirstChild(arg)
            if not tPlr or not tPlr.Character then consoleOut("Player not found: "..arg, Theme.Murderer) return end
            local myHRP = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tgHRP = tPlr.Character:FindFirstChild("HumanoidRootPart")
            if myHRP and tgHRP then
                myHRP.CFrame = tgHRP.CFrame * CFrame.new(0,0,4)
                consoleOut("Teleported to "..arg)
            end

        elseif cmd == "nametag" or cmd == "nt" then
            if openNametagEditor then openNametagEditor()
            else consoleOut("Editor not ready",Theme.Murderer) end

        elseif cmd == "help" then
            consoleOut("fly unfly bring unbring esp fb kill crash respawn fling blind freeze unfreeze tp nametag help")

        else
            consoleOut("Unknown: "..cmd.." (;help for list)", Theme.Murderer)
        end
    end

    inputBox.FocusLost:Connect(function(enterPressed)
        if enterPressed then
            runCommand(inputBox.Text)
            inputBox.Text = ""
        end
    end)

    -- Toggle on Left Alt (desktop)
    UserInputService.InputBegan:Connect(function(inp, gameProcessed)
        if gameProcessed then return end
        if inp.KeyCode == Enum.KeyCode.LeftAlt then
            local nowVisible = not bg.Visible
            bg.Visible = nowVisible
            if nowVisible then
                inputBox.Text = ""
                inputBox:CaptureFocus()
            else
                outBg.Visible = false
            end
        end
        -- Close console on Escape
        if inp.KeyCode == Enum.KeyCode.Escape and bg.Visible then
            bg.Visible = false
            outBg.Visible = false
        end
    end)

    -- ── Persistent bottom command bar (visible on ALL devices) ──
    local bottomBar = Instance.new("Frame", consoleGui)
    bottomBar.Name = "BottomCmdBar"
    bottomBar.Size = UDim2.new(1, -20, 0, 38)
    bottomBar.Position = UDim2.new(0, 10, 1, -48)
    bottomBar.BackgroundColor3 = Theme.BackgroundSecondary
    bottomBar.BorderSizePixel = 0
    Instance.new("UICorner", bottomBar).CornerRadius = UDim.new(0, 10)
    local bbStr = Instance.new("UIStroke", bottomBar)
    bbStr.Color = Theme.Accent  bbStr.Thickness = 1.5

    local bbPrefix = Instance.new("TextLabel", bottomBar)
    bbPrefix.Size = UDim2.new(0, 26, 1, 0)  bbPrefix.Position = UDim2.new(0, 8, 0, 0)
    bbPrefix.BackgroundTransparency = 1  bbPrefix.Text = ";"
    bbPrefix.TextColor3 = Theme.Accent  bbPrefix.Font = Enum.Font.Code
    bbPrefix.TextSize = 16  bbPrefix.TextScaled = false

    local bbBox = Instance.new("TextBox", bottomBar)
    bbBox.Name = "BottomInputBox"
    bbBox.Size = UDim2.new(1, -100, 1, -10)  bbBox.Position = UDim2.new(0, 30, 0, 5)
    bbBox.BackgroundTransparency = 1
    bbBox.PlaceholderText = "Command (e.g. fly, bring Player, help)"
    bbBox.Text = ""  bbBox.TextColor3 = Theme.Text
    bbBox.Font = Enum.Font.Code  bbBox.TextSize = 12  bbBox.TextScaled = false
    bbBox.ClearTextOnFocus = false  bbBox.TextXAlignment = Enum.TextXAlignment.Left

    local bbSend = Instance.new("TextButton", bottomBar)
    bbSend.Size = UDim2.new(0, 54, 1, -10)  bbSend.Position = UDim2.new(1, -60, 0, 5)
    bbSend.BackgroundColor3 = Theme.Accent  bbSend.Text = "Run"
    bbSend.TextColor3 = Color3.new(1,1,1)  bbSend.Font = Enum.Font.GothamBold
    bbSend.TextSize = 12  bbSend.AutoButtonColor = false
    Instance.new("UICorner", bbSend).CornerRadius = UDim.new(0, 6)

    local function runBottomCmd()
        local txt = bbBox.Text:match("^%s*(.-)%s*$")
        if txt ~= "" then
            runCommand(txt)
            bbBox.Text = ""
        end
    end
    bbSend.MouseButton1Click:Connect(runBottomCmd)
    bbBox.FocusLost:Connect(function(enter)
        if enter then runBottomCmd() end
    end)

    return consoleGui
end

-- ============================================================
-- CHAT / MESSAGING PANEL
-- ============================================================
local RANK_LABEL = {
    [0] = "SKA Free",
    [1] = "SKA Premium",
    [2] = "SKA Admin",
    [3] = "SKA Owner",
}
local RANK_CHAT_COLOR = {
    [0] = Color3.fromRGB(160,160,160),
    [1] = Color3.fromRGB(235,180,50),
    [2] = Color3.fromRGB(235,50,50),
    [3] = Color3.fromRGB(255,50,100),
}

local function buildChatPanel()
    local panel = UI.Panels.Chat
    if not panel then return end

    -- State
    local currentMode   = "global"   -- "global" | "game" | "server"
    local lastTimestamp = 0           -- only fetch messages newer than this
    local msgRows       = {}          -- list of rendered row frames

    -- ── Sub-tab bar ──────────────────────────────────────────
    local modeBar = Instance.new("Frame", panel)
    modeBar.Size = UDim2.new(1,-10,0,30)  modeBar.Position = UDim2.new(0,5,0,5)
    modeBar.BackgroundColor3 = Theme.BackgroundTertiary  modeBar.BorderSizePixel = 0
    Instance.new("UICorner", modeBar).CornerRadius = UDim.new(0,8)

    local modeButtons = {}
    local modeDefs = {
        { Key="global", Label="🌐 Global",   Tip="All SKA users everywhere" },
        { Key="game",   Label="🎮 Game",     Tip="Same game (any server)" },
        { Key="server", Label="🖥 Server",   Tip="Same server only" },
    }
    for i, md in ipairs(modeDefs) do
        local b = Instance.new("TextButton", modeBar)
        b.Size = UDim2.new(1/3,-4,1,-6)  b.Position = UDim2.new((i-1)/3,2,0,3)
        b.BackgroundColor3 = (md.Key=="global") and Theme.Accent or Theme.BackgroundSecondary
        b.Text = md.Label
        b.TextColor3 = (md.Key=="global") and Color3.new(1,1,1) or Theme.TextDim
        b.Font = Enum.Font.GothamBold  b.TextSize = 9
        Instance.new("UICorner",b).CornerRadius = UDim.new(0,6)
        modeButtons[md.Key] = b
    end

    -- ── Input area (fixed at bottom, ALWAYS VISIBLE) ──────────
    local inputBG = Instance.new("Frame", panel)
    inputBG.Name = "ChatInputBG"
    inputBG.Size = UDim2.new(1,-10,0,60)  inputBG.Position = UDim2.new(0,5,1,-65)
    inputBG.BackgroundColor3 = Theme.BackgroundSecondary  inputBG.BorderSizePixel = 0
    Instance.new("UICorner", inputBG).CornerRadius = UDim.new(0,8)
    local inputStroke = Instance.new("UIStroke", inputBG)
    inputStroke.Color = Theme.Accent  inputStroke.Thickness = 1

    local inputBox = Instance.new("TextBox", inputBG)
    inputBox.Size = UDim2.new(1,-70,1,-16)  inputBox.Position = UDim2.new(0,8,0,8)
    inputBox.BackgroundTransparency = 1
    inputBox.PlaceholderText = "Type a message..."
    inputBox.Text = ""  inputBox.TextColor3 = Theme.Text
    inputBox.Font = Enum.Font.Gotham  inputBox.TextSize = 12
    inputBox.ClearTextOnFocus = false  inputBox.TextWrapped = true
    inputBox.MultiLine = false  inputBox.TextXAlignment = Enum.TextXAlignment.Left

    local sendBtn = Instance.new("TextButton", inputBG)
    sendBtn.Size = UDim2.new(0,56,1,-16)  sendBtn.Position = UDim2.new(1,-62,0,8)
    sendBtn.BackgroundColor3 = Theme.Accent  sendBtn.Text = "Send"
    sendBtn.TextColor3 = Color3.new(1,1,1)  sendBtn.Font = Enum.Font.GothamBold
    sendBtn.TextSize = 12  sendBtn.AutoButtonColor = false
    Instance.new("UICorner",sendBtn).CornerRadius = UDim.new(0,6)
    sendBtn.MouseEnter:Connect(function() tween(sendBtn,{BackgroundColor3=Theme.Accent:Lerp(Color3.new(1,1,1),0.15)},0.12) end)
    sendBtn.MouseLeave:Connect(function() tween(sendBtn,{BackgroundColor3=Theme.Accent},0.12) end)

    -- ── Message list ─────────────────────────────────────────
    local listFrame = Instance.new("ScrollingFrame", panel)
    listFrame.Name = "ChatList"
    listFrame.Size = UDim2.new(1,-10,1,-110)  listFrame.Position = UDim2.new(0,5,0,40)
    listFrame.BackgroundColor3 = Theme.BackgroundSecondary  listFrame.BorderSizePixel = 0
    listFrame.ScrollBarThickness = 4  listFrame.CanvasSize = UDim2.new(0,0,0,0)
    listFrame.ScrollingDirection = Enum.ScrollingDirection.Y
    Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0,8)
    local listLayout = Instance.new("UIListLayout", listFrame)
    listLayout.Padding = UDim.new(0,2)  listLayout.SortOrder = Enum.SortOrder.LayoutOrder
    local listPad = Instance.new("UIPadding", listFrame)
    listPad.PaddingLeft = UDim.new(0,6)  listPad.PaddingRight = UDim.new(0,6)
    listPad.PaddingTop = UDim.new(0,4)   listPad.PaddingBottom = UDim.new(0,4)

    -- Empty-state label
    local emptyLbl = Instance.new("TextLabel", listFrame)
    emptyLbl.Name = "EmptyLbl"
    emptyLbl.Size = UDim2.new(1,-12,0,40)  emptyLbl.Position = UDim2.new(0,6,0,8)
    emptyLbl.BackgroundTransparency = 1
    emptyLbl.Text = "No messages yet. Switch mode or say something!"
    emptyLbl.TextColor3 = Theme.TextDim  emptyLbl.Font = Enum.Font.Gotham
    emptyLbl.TextSize = 11  emptyLbl.TextWrapped = true
    emptyLbl.TextXAlignment = Enum.TextXAlignment.Center
    emptyLbl.LayoutOrder = 999999

    -- Helper: add one message row to the list
    local function addMessageRow(msg)
        if emptyLbl and emptyLbl.Parent then emptyLbl:Destroy() end

        local rank       = msg.rank or 0
        local dispName   = msg.displayName or msg.username or "?"
        local username   = msg.username or "?"
        local rankLabel  = RANK_LABEL[rank]  or "SKA Free"
        local rankColor  = RANK_CHAT_COLOR[rank] or Color3.fromRGB(160,160,160)
        local msgText    = msg.message or ""

        local row = Instance.new("Frame", listFrame)
        row.Size = UDim2.new(1,-8,0,0)  -- height auto-set below
        row.BackgroundTransparency = 1  row.BorderSizePixel = 0
        row.LayoutOrder = math.floor((msg.timestamp or 0) * 1000)
        row.AutomaticSize = Enum.AutomaticSize.Y

        -- Rank colour bar on left
        local bar = Instance.new("Frame", row)
        bar.Size = UDim2.new(0,3,1,0)  bar.BackgroundColor3 = rankColor  bar.BorderSizePixel = 0
        Instance.new("UICorner",bar).CornerRadius = UDim.new(0,2)

        -- Header: "DisplayName" (SKA Rank)
        local header = Instance.new("TextLabel", row)
        header.Size = UDim2.new(1,-10,0,16)  header.Position = UDim2.new(0,9,0,2)
        header.BackgroundTransparency = 1
        header.Text = '"'..dispName..'" ('..rankLabel..')'
        header.TextColor3 = rankColor  header.Font = Enum.Font.GothamBold
        header.TextSize = 10  header.TextXAlignment = Enum.TextXAlignment.Left

        -- Message body
        local body = Instance.new("TextLabel", row)
        body.Size = UDim2.new(1,-10,0,0)  body.Position = UDim2.new(0,9,0,18)
        body.BackgroundTransparency = 1  body.AutomaticSize = Enum.AutomaticSize.Y
        body.Text = msgText  body.TextColor3 = Theme.Text
        body.Font = Enum.Font.Gotham  body.TextSize = 11
        body.TextWrapped = true  body.TextXAlignment = Enum.TextXAlignment.Left

        table.insert(msgRows, row)

        -- Auto-scroll to bottom
        task.defer(function()
            local canvas = listLayout.AbsoluteContentSize.Y + 8
            listFrame.CanvasSize = UDim2.new(0,0,0,canvas)
            listFrame.CanvasPosition = Vector2.new(0, math.max(0, canvas - listFrame.AbsoluteSize.Y))
        end)
    end

    -- ── Mode switching logic ──────────────────────────────────
    local function switchMode(key)
        currentMode   = key
        lastTimestamp = 0   -- reset so we fetch recent history on mode change
        -- Clear existing messages
        for _, r in ipairs(msgRows) do pcall(function() r:Destroy() end) end
        msgRows = {}
        -- Re-add empty label
        if not listFrame:FindFirstChild("EmptyLbl") then
            local el = Instance.new("TextLabel", listFrame)
            el.Name = "EmptyLbl"  el.Size = UDim2.new(1,-12,0,40)  el.Position = UDim2.new(0,6,0,8)
            el.BackgroundTransparency = 1
            el.Text = "No messages yet. Switch mode or say something!"
            el.TextColor3 = Theme.TextDim  el.Font = Enum.Font.Gotham
            el.TextSize = 11  el.TextWrapped = true
            el.TextXAlignment = Enum.TextXAlignment.Center  el.LayoutOrder = 999999
        end
        -- Update button highlights
        for k, b in pairs(modeButtons) do
            b.BackgroundColor3 = (k==key) and Theme.Accent or Theme.BackgroundSecondary
            b.TextColor3       = (k==key) and Color3.new(1,1,1) or Theme.TextDim
        end
    end

    for _, md in ipairs(modeDefs) do
        local key = md.Key
        modeButtons[key].MouseButton1Click:Connect(function() switchMode(key) end)
    end

    -- ── Send message ─────────────────────────────────────────
    local function sendMessage()
        if not http_request then
            notify("Chat","Bridge unavailable — HTTP not supported by this executor",3) return
        end
        local txt = inputBox.Text:match("^%s*(.-)%s*$")
        if txt == "" then return end
        inputBox.Text = ""

        pcall(function()
            http_request({
                Url     = CONFIG.LocalHostURL.."/chat/send",
                Method  = "POST",
                Headers = {["Content-Type"]="application/json"},
                Body    = HttpService:JSONEncode({
                    username    = localPlayer.Name,
                    displayName = localPlayer.DisplayName,
                    rank        = LocalUser.Rank,
                    message     = txt,
                    mode        = currentMode,
                    jobId       = game.JobId,
                    placeId     = tostring(game.PlaceId),
                })
            })
        end)
    end

    -- Wire up input box (already created above listFrame)
    sendBtn.MouseButton1Click:Connect(sendMessage)
    inputBox.FocusLost:Connect(function(enter)
        if enter then sendMessage() end
    end)

    -- ── Auto-polling loop (every 3s, fully automatic) ────────
    task.spawn(function()
        while panel and panel.Parent do
            task.wait(3)
            if not http_request then continue end
            -- Only poll if the Chat tab is visible (panel.Visible) to save requests
            -- But we always poll so messages don't pile up when user switches tabs
            pcall(function()
                local params = "?mode="..currentMode.."&since="..string.format("%.3f", lastTimestamp)
                if currentMode == "server" then
                    params = params.."&jobId="..game.JobId
                elseif currentMode == "game" then
                    params = params.."&placeId="..tostring(game.PlaceId)
                end
                local res = http_request({ Url=CONFIG.LocalHostURL.."/chat/get"..params, Method="GET" })
                if res and res.StatusCode == 200 and res.Body then
                    local ok, data = pcall(function() return HttpService:JSONDecode(res.Body) end)
                    if ok and data.messages and #data.messages > 0 then
                        for _, msg in ipairs(data.messages) do
                            if (msg.timestamp or 0) > lastTimestamp then
                                lastTimestamp = msg.timestamp
                                addMessageRow(msg)
                            end
                        end
                    end
                end
            end)
        end
    end)

    -- Chat panel must NOT scroll as a whole — only the message list scrolls.
    -- Input bar is positionally fixed at the bottom of the visible area.
    panel.CanvasSize = UDim2.new(0, 0, 0, 0)
    panel.ScrollingEnabled = false
    panel.ScrollBarThickness = 0
end

local function initialize()
    -- Build UI
    createMainUI()
    createMiniButton()
    createTopBar()
    buildCombatPanel()
    buildVisualsPanel()
    buildAdminPanel()
    buildChatPanel()
    buildSettingsPanel()
    buildCreditsPanel()
    createAltConsole()

    -- Nametag loop — RenderStepped matches working version exactly
    RunService.RenderStepped:Connect(updateNametags)

    -- Player removed cleanup
    Players.PlayerRemoving:Connect(function(plr)
        if Nametags[plr] then
            pcall(function() Nametags[plr].Gui:Destroy()      end)
            pcall(function() Nametags[plr].PortalGui:Destroy() end)
            Nametags[plr]=nil
        end
        if Highlights[plr] then
            pcall(function() Highlights[plr]:Destroy() end)
            Highlights[plr]=nil
        end
    end)

    -- Player added: rebuild nametag when character respawns
    Players.PlayerAdded:Connect(function(plr)
        plr.CharacterAdded:Connect(function()
            task.wait(1)
            if Nametags[plr] then
                pcall(function() Nametags[plr].Gui:Destroy()      end)
                pcall(function() Nametags[plr].PortalGui:Destroy() end)
                Nametags[plr]=nil
            end
        end)
    end)

    -- Self respawn: rebuild own nametag
    localPlayer.CharacterAdded:Connect(function()
        task.wait(1)
        if Nametags[localPlayer] then
            pcall(function() Nametags[localPlayer].Gui:Destroy()      end)
            pcall(function() Nametags[localPlayer].PortalGui:Destroy() end)
            Nametags[localPlayer]=nil
        end
    end)

    -- Apply initial theme
    applyTheme()
    updateStatus()

    -- Ban / rank check after data loads
    task.delay(2, function()
        -- Re-fetch once more in case first attempt raced
        fetchGitHub()
        task.wait(0.5)
        if LocalUser.IsBanned then
            local msg = string.format(
                "Banned from SKA by %s\nReason: %s",
                tostring(LocalUser.BannedBy or "an admin"),
                tostring(LocalUser.BanReason or "No reason given")
            )
            -- Destroy UI then kick
            pcall(function()
                if UI.MainFrame then UI.MainFrame:Destroy() end
                if UI.TopBar    then UI.TopBar:Destroy()    end
                if UI.MiniButton then UI.MiniButton:Destroy() end
            end)
            pcall(function() localPlayer:Kick(msg) end)
        else
            local tag = (RANK_INFO[LocalUser.Rank] and RANK_INFO[LocalUser.Rank].Tag) or LocalUser.Tag
            notify("SKA Admin","v9.1 loaded  ·  "..tostring(tag), 4)
            log("Init complete — Rank="..tostring(LocalUser.Rank).." Tag="..tostring(LocalUser.Tag))
        end
    end)

    print("[SKA] v9.1 initialized — "..localPlayer.Name)
end

initialize()
